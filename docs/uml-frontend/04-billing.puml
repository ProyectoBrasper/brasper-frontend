@startuml
' Brasper Platform Frontend - Billing Bounded Context (Angular 22 + Angular Material)

skinparam classAttributeIconSize 0
hide empty members

package "app" {

  package "shared" {
    package "domain.model" {
      interface BaseEntity
    }
    package "infrastructure" {
      interface BaseResource
      interface BaseResponse
      interface BaseAssembler<TEntity, TResource, TResponse>
      abstract class BaseApiEndpoint<TEntity, TResource, TResponse, TAssembler>
      abstract class BaseApi
    }
    package "presentation" {
      abstract class BaseForm
      package "components" {
        class StatusChip <<Component>>
        class PeriodSelector <<Component>>
        class ConfirmDialog <<Component>>
      }
    }
  }

  package "projects" {
    package "application" {
      class ProjectsStore <<Store>>
    }
  }

  package "treasury" {
    package "application" {
      class TreasuryStore <<Store>>
    }
  }

  package "accounting" {
    package "application" {
      class AccountingStore <<Store>>
    }
  }

  ' ==========================================
  ' BILLING BOUNDED CONTEXT
  ' ==========================================
  package "billing" {
    package "domain.model" {
      class Invoice <<Entity>> {
        - #id: number
        - #number: string
        - #issuedOn: string
        - #purchaseOrder: string
        - #projectId: number
        - #clientId: number
        - #currency: string
        - #taxableBase: number
        - #igv: number
        - #total: number
        - #retention: number
        - #detraction: number
        - #selfDetraction: boolean
        - #advance: boolean
        - #netAmount: number
        - #collectedAmount: number
        - #outstandingBalance: number
        - #status: InvoiceStatus
        - #notes: string
        +id: number
        +number: string
        +issuedOn: string
        +purchaseOrder: string
        +projectId: number
        +clientId: number
        +currency: string
        +taxableBase: number
        +igv: number
        +total: number
        +retention: number
        +detraction: number
        +selfDetraction: boolean
        +advance: boolean
        +netAmount: number
        +collectedAmount: number
        +outstandingBalance: number
        +status: InvoiceStatus
        +notes: string
        +isVoided(): boolean
        +isCollectable(): boolean
        +canBeVoided(): boolean
      }
      Invoice ..|> app.shared.domain.model.BaseEntity : implements

      enum InvoiceStatus {
        PENDING
        PARTIALLY_COLLECTED
        COLLECTED
        VOIDED
      }
      Invoice --> InvoiceStatus : has

      class InvoicePayment <<Entity>> {
        - #id: number
        - #invoiceId: number
        - #receivedOn: string
        - #amount: number
        - #type: InvoicePaymentType
        - #bankAccountId: number
        - #reference: string
        +id: number
        +invoiceId: number
        +receivedOn: string
        +amount: number
        +type: InvoicePaymentType
        +bankAccountId: number
        +reference: string
      }
      InvoicePayment ..|> app.shared.domain.model.BaseEntity : implements
      Invoice "1" <-- "*" InvoicePayment : references invoiceId

      enum InvoicePaymentType {
        NET_DEPOSIT
        DETRACTION_DEPOSIT
        RETENTION_CERTIFICATE
      }
      InvoicePayment --> InvoicePaymentType : has

      class ScheduledCollection <<Entity>> {
        - #id: number
        - #projectId: number
        - #expectedAmount: number
        - #year: number
        - #month: number
        - #week: number
        - #status: ScheduleStatus
        - #invoiceId: number | null
        - #notes: string
        +id: number
        +projectId: number
        +expectedAmount: number
        +year: number
        +month: number
        +week: number
        +status: ScheduleStatus
        +invoiceId: number | null
        +notes: string
      }
      ScheduledCollection ..|> app.shared.domain.model.BaseEntity : implements

      enum ScheduleStatus {
        SCHEDULED
        REALIZED
        RESCHEDULED
        CANCELLED
      }
      ScheduledCollection --> ScheduleStatus : has

      class InvoiceAmountsCalculator <<DomainService>> {
        +preview(taxableBase: number, hasRetention: boolean, hasDetraction: boolean, rates: TaxRates): InvoiceAmountsPreview
      }
    }

    package "infrastructure" {
      class InvoiceResource <<Resource>> {
        +id: number
        +number: string
        +issuedOn: string
        +purchaseOrder: string
        +projectId: number
        +clientId: number
        +currency: string
        +taxableBase: number
        +igv: number
        +total: number
        +retention: number
        +detraction: number
        +selfDetraction: boolean
        +advance: boolean
        +netAmount: number
        +collectedAmount: number
        +outstandingBalance: number
        +status: string
        +notes: string
      }
      class InvoicePaymentResource <<Resource>> {
        +id: number
        +invoiceId: number
        +receivedOn: string
        +amount: number
        +type: string
        +bankAccountId: number
        +reference: string
      }
      class ScheduledCollectionResource <<Resource>> {
        +id: number
        +projectId: number
        +expectedAmount: number
        +year: number
        +month: number
        +week: number
        +status: string
        +invoiceId: number | null
        +notes: string
      }
      class InvoicesResponse <<Response>> {
      }
      class InvoicePaymentsResponse <<Response>> {
      }
      class ScheduledCollectionsResponse <<Response>> {
      }

      class InvoiceAssembler <<Assembler>> {
        +toEntitiesFromResponse(response: InvoicesResponse): Invoice[]
        +toEntityFromResource(resource: InvoiceResource): Invoice
        +toResourceFromEntity(entity: Invoice): InvoiceResource
      }
      class InvoicePaymentAssembler <<Assembler>> {
        +toEntitiesFromResponse(response: InvoicePaymentsResponse): InvoicePayment[]
        +toEntityFromResource(resource: InvoicePaymentResource): InvoicePayment
        +toResourceFromEntity(entity: InvoicePayment): InvoicePaymentResource
      }
      class ScheduledCollectionAssembler <<Assembler>> {
        +toEntitiesFromResponse(response: ScheduledCollectionsResponse): ScheduledCollection[]
        +toEntityFromResource(resource: ScheduledCollectionResource): ScheduledCollection
        +toResourceFromEntity(entity: ScheduledCollection): ScheduledCollectionResource
      }

      class InvoicesApiEndpoint {
        +voidInvoice(id: number): Observable<Invoice>
        +getByProjectId(projectId: number): Observable<Invoice[]>
      }
      class InvoicePaymentsApiEndpoint {
        +getByInvoiceId(invoiceId: number): Observable<InvoicePayment[]>
        +register(invoiceId: number, payment: InvoicePayment): Observable<InvoicePayment>
      }
      class ScheduledCollectionsApiEndpoint {
        +getByPeriod(year: number, month: number): Observable<ScheduledCollection[]>
      }

      class BillingApi {
        -invoicesEndpoint: InvoicesApiEndpoint
        -invoicePaymentsEndpoint: InvoicePaymentsApiEndpoint
        -scheduledCollectionsEndpoint: ScheduledCollectionsApiEndpoint
        +getInvoices(): Observable<Invoice[]>
        +getInvoiceById(id: number): Observable<Invoice>
        +issueInvoice(invoice: Invoice): Observable<Invoice>
        +voidInvoice(id: number): Observable<Invoice>
        +getPayments(invoiceId: number): Observable<InvoicePayment[]>
        +registerPayment(invoiceId: number, payment: InvoicePayment): Observable<InvoicePayment>
        +getScheduledCollections(year: number, month: number): Observable<ScheduledCollection[]>
        +scheduleCollection(collection: ScheduledCollection): Observable<ScheduledCollection>
        +updateScheduledCollection(collection: ScheduledCollection): Observable<ScheduledCollection>
      }

      InvoiceResource ..|> app.shared.infrastructure.BaseResource : implements
      InvoicePaymentResource ..|> app.shared.infrastructure.BaseResource : implements
      ScheduledCollectionResource ..|> app.shared.infrastructure.BaseResource : implements
      InvoicesResponse ..|> app.shared.infrastructure.BaseResponse : implements
      InvoicePaymentsResponse ..|> app.shared.infrastructure.BaseResponse : implements
      ScheduledCollectionsResponse ..|> app.shared.infrastructure.BaseResponse : implements
      InvoiceAssembler ..|> app.shared.infrastructure.BaseAssembler : implements
      InvoicePaymentAssembler ..|> app.shared.infrastructure.BaseAssembler : implements
      ScheduledCollectionAssembler ..|> app.shared.infrastructure.BaseAssembler : implements
      InvoicesApiEndpoint --|> app.shared.infrastructure.BaseApiEndpoint : extends
      InvoicePaymentsApiEndpoint --|> app.shared.infrastructure.BaseApiEndpoint : extends
      ScheduledCollectionsApiEndpoint --|> app.shared.infrastructure.BaseApiEndpoint : extends
      BillingApi --|> app.shared.infrastructure.BaseApi : extends
      BillingApi --> InvoicesApiEndpoint : delegates to
      BillingApi --> InvoicePaymentsApiEndpoint : delegates to
      BillingApi --> ScheduledCollectionsApiEndpoint : delegates to
      InvoicesApiEndpoint --> InvoiceAssembler : uses
      InvoicePaymentsApiEndpoint --> InvoicePaymentAssembler : uses
      ScheduledCollectionsApiEndpoint --> ScheduledCollectionAssembler : uses
    }

    package "application" {
      class BillingStore <<Store>> {
        -billingApi: BillingApi
        -invoicesSignal: WritableSignal<Invoice[]>
        -paymentsSignal: WritableSignal<InvoicePayment[]>
        -scheduledCollectionsSignal: WritableSignal<ScheduledCollection[]>
        -loadingSignal: WritableSignal<boolean>
        -errorSignal: WritableSignal<string | null>
        +invoices: Signal<Invoice[]>
        +pendingInvoices: Signal<Invoice[]>
        +totalOutstanding: Signal<number>
        +payments: Signal<InvoicePayment[]>
        +scheduledCollections: Signal<ScheduledCollection[]>
        +loading: Signal<boolean>
        +error: Signal<string | null>
        +canWrite: Signal<boolean>
        +loadInvoices(): void
        +countByStatus(status: InvoiceStatus | null): number
        +loadInvoiceDetail(id: number): void
        +issueInvoice(invoice: Invoice): void
        +voidInvoice(id: number): void
        +registerPayment(invoiceId: number, payment: InvoicePayment): void
        +loadScheduledCollections(year: number, month: number): void
        +scheduleCollection(collection: ScheduledCollection): void
        +rescheduleCollection(collection: ScheduledCollection): void
        +getInvoiceById(id: number): Invoice | undefined
      }
      BillingStore --> BillingApi : uses
      BillingStore --> Invoice : manages
      BillingStore --> InvoicePayment : manages
      BillingStore --> ScheduledCollection : manages
    }

    package "presentation" {
      package "components" {
        class InvoiceAmountsSummary <<Component>> {
          +taxableBase: InputSignal<number>
          +igv: InputSignal<number>
          +total: InputSignal<number>
          +retention: InputSignal<number>
          +detraction: InputSignal<number>
          +netAmount: InputSignal<number>
        }
        class RegisterPaymentDialog <<Component>> {
          -formBuilder: FormBuilder
          -dialogRef: MatDialogRef<RegisterPaymentDialog>
          -treasuryStore: TreasuryStore
          +data: {invoice: Invoice}
          +paymentForm: FormGroup
          +paymentTypes: InvoicePaymentType[]
          +bankAccounts: Signal<BankAccount[]>
          +onSave(): void
          +onCancel(): void
        }
        class ScheduledCollectionDialog <<Component>> {
          -formBuilder: FormBuilder
          -dialogRef: MatDialogRef<ScheduledCollectionDialog>
          -projectsStore: ProjectsStore
          +data: {collection: ScheduledCollection | null}
          +collectionForm: FormGroup
          +onSave(): void
          +onCancel(): void
        }
      }

      package "views" {
        class InvoiceList <<Component>> {
          -billingStore: BillingStore
          -router: Router
          +displayedColumns: string[]
          +dataSource: Signal<MatTableDataSource<Invoice>>
          +paginator: Signal<MatPaginator>
          +sort: Signal<MatSort>
          +statusFilter: WritableSignal<InvoiceStatus | null>
          +onView(id: number): void
          +onAdd(): void
        }
        class InvoiceForm <<Component>> {
          -formBuilder: FormBuilder
          -billingStore: BillingStore
          -projectsStore: ProjectsStore
          -accountingStore: AccountingStore
          -router: Router
          +invoiceForm: FormGroup
          +projects: Signal<Project[]>
          +amountsPreview: Signal<InvoiceAmountsPreview>
          +onSubmit(): void
          +onCancel(): void
        }
        class InvoiceDetail <<Component>> {
          -billingStore: BillingStore
          -dialog: MatDialog
          -route: ActivatedRoute
          +invoice: Signal<Invoice | undefined>
          +payments: Signal<InvoicePayment[]>
          +onRegisterPayment(): void
          +onVoid(): void
        }
        class ScheduledCollectionList <<Component>> {
          -billingStore: BillingStore
          -dialog: MatDialog
          +period: WritableSignal<Period>
          +displayedColumns: string[]
          +dataSource: Signal<MatTableDataSource<ScheduledCollection>>
          +onAdd(): void
          +onReschedule(collection: ScheduledCollection): void
        }
      }

      InvoiceList --> BillingStore : uses
      InvoiceForm --> BillingStore : uses
      InvoiceDetail --> BillingStore : uses
      ScheduledCollectionList --> BillingStore : uses
      InvoiceForm --|> app.shared.presentation.BaseForm : extends
      InvoiceForm --> InvoiceAmountsCalculator : previews with
      InvoiceForm --> InvoiceAmountsSummary : contains
      InvoiceForm --> app.projects.application.ProjectsStore : reads projects
      InvoiceForm --> app.accounting.application.AccountingStore : reads tax rates
      InvoiceDetail --> InvoiceAmountsSummary : contains
      InvoiceDetail --> RegisterPaymentDialog : opens
      InvoiceDetail --> app.shared.presentation.components.ConfirmDialog : opens
      RegisterPaymentDialog --> app.treasury.application.TreasuryStore : reads bank accounts
      ScheduledCollectionList --> ScheduledCollectionDialog : opens
      ScheduledCollectionList --> app.shared.presentation.components.PeriodSelector : contains
      ScheduledCollectionDialog --> app.projects.application.ProjectsStore : reads projects
      InvoiceList --> app.shared.presentation.components.StatusChip : contains
    }
  }
}

note bottom
  InvoiceForm calcula una VISTA PREVIA (InvoiceAmountsCalculator) con las tasas vigentes
  (IGV 18%, detracción 12%, retención 3%): igv, total, detracción, retención y neto.
  El cálculo oficial lo hace el backend; con json-server se guardan los montos ya calculados.
  RegisterPaymentDialog: DETRACTION_DEPOSIT solo permite cuentas tipo DETRACTIONS (Banco de la Nación).
  json-server (colecciones planas + routes.json): /invoices, /invoice-payments?invoiceId=,
  /scheduled-collections?year=&month=;
  voidInvoice = PATCH /invoices/{id} {status: 'VOIDED'}.
end note
@enduml
