@startuml
' Brasper Platform Frontend - Treasury Bounded Context (Angular 22 + Angular Material)

skinparam classAttributeIconSize 0
hide empty members

package "app" {

  package "shared" {
    package "domain.model" {
      interface BaseEntity
    }
    package "infrastructure" {
      interface BaseResource
      interface BaseResponse
      interface BaseAssembler<TEntity, TResource, TResponse>
      abstract class BaseApiEndpoint<TEntity, TResource, TResponse, TAssembler>
      abstract class BaseApi
    }
    package "presentation" {
      abstract class BaseForm
      package "components" {
        class StatusChip <<Component>>
        class PeriodSelector <<Component>>
      }
    }
  }

  ' ==========================================
  ' TREASURY BOUNDED CONTEXT
  ' ==========================================
  package "treasury" {
    package "domain.model" {
      class BankAccount <<Entity>> {
        - #id: number
        - #bank: Bank
        - #accountNumber: string
        - #type: AccountType
        - #currency: string
        - #openingBalance: number
        - #currentBalance: number
        +id: number
        +bank: Bank
        +accountNumber: string
        +type: AccountType
        +currency: string
        +openingBalance: number
        +currentBalance: number
      }
      BankAccount ..|> app.shared.domain.model.BaseEntity : implements

      enum Bank {
        BCP
        BBVA
        BANCO_DE_LA_NACION
        CASH
      }
      enum AccountType {
        CHECKING
        DETRACTIONS
        PETTY_CASH
      }
      BankAccount --> Bank : has
      BankAccount --> AccountType : has

      class CashMovement <<Entity>> {
        - #id: number
        - #occurredOn: string
        - #direction: MovementDirection
        - #amount: number
        - #concept: string
        - #source: MovementSource
        - #sourceId: number | null
        +id: number
        +occurredOn: string
        +direction: MovementDirection
        +amount: number
        +concept: string
        +source: MovementSource
        +sourceId: number | null
        +isInflow(): boolean
      }
      CashMovement ..|> app.shared.domain.model.BaseEntity : implements
      BankAccount "1" *-- "*" CashMovement : movements of the month

      enum MovementDirection {
        INFLOW
        OUTFLOW
      }
      enum MovementSource {
        OPENING_BALANCE
        INVOICE_PAYMENT
        EXPENSE
        FIXED_COST_PAYMENT
        PAYABLE_PAYMENT
        LOAN_DISBURSEMENT
        LOAN_INSTALLMENT
        PARTNER_CONTRIBUTION
        TAX_PAYMENT
        TRANSFER
        ADJUSTMENT
      }
      CashMovement --> MovementDirection : has
      CashMovement --> MovementSource : has

      class Payable <<Entity>> {
        - #id: number
        - #concept: string
        - #type: PayableType
        - #totalAmount: number
        - #currency: string
        - #paidAmount: number
        - #balance: number
        - #supplierId: number | null
        - #projectId: number | null
        - #expenseId: number | null
        - #year: number
        - #month: number
        - #week: number
        - #status: PaymentStatus
        +id: number
        +concept: string
        +type: PayableType
        +totalAmount: number
        +currency: string
        +paidAmount: number
        +balance: number
        +supplierId: number | null
        +projectId: number | null
        +expenseId: number | null
        +year: number
        +month: number
        +week: number
        +status: PaymentStatus
        +isPaid(): boolean
        +cashFlowWeek(): CashFlowWeek
      }
      Payable ..|> app.shared.domain.model.BaseEntity : implements

      enum PayableType {
        SUPPLIER
        TECHNICIAN
        ACCOUNTING
        SELF_DETRACTION
        TAX
        OTHER
      }
      enum PaymentStatus {
        PENDING
        PARTIALLY_PAID
        PAID
      }
      Payable --> PayableType : has
      Payable --> PaymentStatus : has

      class CreatePayableCommand <<Command>> {
        +concept: string
        +type: PayableType
        +totalAmount: number
        +currency: string
        +supplierId: number | null
        +projectId: number | null
        +week: CashFlowWeek
      }
      class RegisterLoanCommand <<Command>> {
        +type: LoanType
        +counterparty: string
        +principal: number
        +currency: string
        +interestRate: number
        +disbursedOn: string
        +bankAccountId: number
      }
      class RegisterPayablePaymentCommand <<Command>> {
        +paidOn: string
        +amount: number
        +bankAccountId: number
      }
      note right of RegisterPayablePaymentCommand
        El backend no expone los pagos de una cuenta por pagar:
        solo paidAmount y balance en PayableResource.
      end note

      class Loan <<Entity>> {
        - #id: number
        - #type: LoanType
        - #counterparty: string
        - #principal: number
        - #currency: string
        - #interestRate: number
        - #disbursedOn: string
        - #bankAccountId: number
        - #totalInterest: number
        - #outstandingBalance: number
        - #status: PaymentStatus
        - #installments: LoanInstallment[]
        +id: number
        +type: LoanType
        +counterparty: string
        +principal: number
        +currency: string
        +interestRate: number
        +disbursedOn: string
        +bankAccountId: number
        +totalInterest: number
        +outstandingBalance: number
        +status: PaymentStatus
        +installments: LoanInstallment[]
        +isReceived(): boolean
        +isPaid(): boolean
      }
      note right of Loan
        interestRate es una fracción (0.12 = 12 % anual) y solo informa: el interés sale de las cuotas.
        El saldo, el interés total y el estado los calcula el backend; las cuotas llegan dentro del préstamo.
      end note
      Loan ..|> app.shared.domain.model.BaseEntity : implements

      enum LoanType {
        RECEIVED
        GRANTED
      }
      Loan --> LoanType : has

      class LoanInstallment <<Entity>> {
        - #id: number
        - #dueOn: string
        - #principal: number
        - #interest: number
        - #paid: boolean
        - #paidOn: string | null
        +id: number
        +dueOn: string
        +principal: number
        +interest: number
        +paid: boolean
        +paidOn: string | null
        +total(): number
      }
      LoanInstallment ..|> app.shared.domain.model.BaseEntity : implements
      Loan "1" *-- "*" LoanInstallment : contains

      class Partner <<Entity>> {
        - #id: number
        - #fullName: string
        - #role: string
        - #totalContributed: number
        +id: number
        +fullName: string
        +role: string
        +totalContributed: number
      }
      Partner ..|> app.shared.domain.model.BaseEntity : implements

      class PartnerContribution <<Entity>> {
        - #id: number
        - #partnerId: number
        - #contributedOn: string
        - #amount: number
        - #reimbursable: boolean
        - #bankAccountId: number | null
        - #expenseId: number | null
        - #concept: string
        +id: number
        +partnerId: number
        +contributedOn: string
        +amount: number
        +reimbursable: boolean
        +bankAccountId: number | null
        +expenseId: number | null
        +concept: string
      }
      PartnerContribution ..|> app.shared.domain.model.BaseEntity : implements
      Partner "1" <-- "*" PartnerContribution : references partnerId

      class TransferFundsCommand <<Command>> {
        +fromAccountId: number
        +toAccountId: number
        +transferredOn: string
        +amount: number
        +concept: string
      }
      class RegisterAdjustmentCommand <<Command>> {
        +occurredOn: string
        +direction: MovementDirection
        +amount: number
        +concept: string
      }
    }

    package "infrastructure" {
      class BankAccountResource <<Resource>> {
        +id: number
        +bank: string
        +accountNumber: string
        +type: string
        +currency: string
        +openingBalance: number
        +currentBalance: number
      }
      class CashMovementResource <<Resource>> {
        +id: number
        +occurredOn: string
        +direction: string
        +amount: number
        +concept: string | null
        +source: string
        +sourceId: number | null
      }
      class PayableResource <<Resource>> {
        +id: number
        +concept: string
        +type: string
        +totalAmount: number
        +currency: string
        +paidAmount: number
        +balance: number
        +supplierId: number | null
        +projectId: number | null
        +expenseId: number | null
        +year: number
        +month: number
        +week: number
        +status: string
      }
      class LoanResource <<Resource>> {
        +id: number
        +type: string
        +counterparty: string
        +principal: number
        +currency: string
        +interestRate: number
        +disbursedOn: string
        +bankAccountId: number
        +totalInterest: number
        +outstandingBalance: number
        +status: string
        +installments: LoanInstallmentResource[]
      }
      class LoanInstallmentResource <<Resource>> {
        +id: number
        +dueOn: string
        +principal: number
        +interest: number
        +paid: boolean
        +paidOn: string | null
      }
      class PartnerResource <<Resource>> {
        +id: number
        +fullName: string
        +role: string
        +totalContributed: number
      }
      class PartnerContributionResource <<Resource>> {
        +id: number
        +partnerId: number
        +contributedOn: string
        +amount: number
        +reimbursable: boolean
        +bankAccountId: number | null
        +expenseId: number | null
        +concept: string
      }
      class BankAccountsResponse <<Response>> {
      }
      class PayablesResponse <<Response>> {
      }
      class LoansResponse <<Response>> {
      }
      class PartnersResponse <<Response>> {
      }
      class PartnerContributionsResponse <<Response>> {
      }

      class BankAccountAssembler <<Assembler>> {
        +toEntitiesFromResponse(response: BankAccountsResponse): BankAccount[]
        +toEntityFromResource(resource: BankAccountResource): BankAccount
        +toResourceFromEntity(entity: BankAccount): BankAccountResource
      }
      class CashMovementAssembler <<Assembler>> {
        +toEntityFromResource(resource: CashMovementResource): CashMovement
      }
      class PayableAssembler <<Assembler>> {
        +toEntitiesFromResponse(response: PayablesResponse): Payable[]
        +toEntityFromResource(resource: PayableResource): Payable
        +toResourceFromEntity(entity: Payable): PayableResource
      }
      class LoanAssembler <<Assembler>> {
        +toEntitiesFromResponse(response: LoansResponse): Loan[]
        +toEntityFromResource(resource: LoanResource): Loan
        +toResourceFromEntity(entity: Loan): LoanResource
      }
      class PartnerAssembler <<Assembler>> {
        +toEntitiesFromResponse(response: PartnersResponse): Partner[]
        +toEntityFromResource(resource: PartnerResource): Partner
        +toResourceFromEntity(entity: Partner): PartnerResource
      }
      class PartnerContributionAssembler <<Assembler>> {
        +toEntitiesFromResponse(response: PartnerContributionsResponse): PartnerContribution[]
        +toEntityFromResource(resource: PartnerContributionResource): PartnerContribution
        +toResourceFromEntity(entity: PartnerContribution): PartnerContributionResource
      }

      note top of BankAccountsApiEndpoint
        Implementado: getAll(), getById(), open(), getMovements(), adjust() y transfer(). Los movimientos,
        ajustes y transferencias cuelgan de /bank-accounts, como en el backend (no hay endpoint aparte).
      end note
      class OpenBankAccountRequest <<Request>> {
        +bank: string
        +accountNumber: string
        +type: string
        +currency: string
        +openingBalance: number
        +openedOn: string
      }
      class BankAccountsApiEndpoint {
        +open(command: OpenBankAccountCommand): Observable<BankAccount>
        +getMovements(id: number, year: number, month: number): Observable<CashMovement[]>
        +adjust(id: number, command: RegisterAdjustmentCommand): Observable<BankAccount>
        +transfer(command: TransferFundsCommand): Observable<BankAccount>
      }
      class PayablesApiEndpoint {
        +createPayable(command: CreatePayableCommand): Observable<Payable>
        +pay(id: number, command: RegisterPayablePaymentCommand): Observable<Payable>
        +reschedule(id: number, week: CashFlowWeek): Observable<Payable>
      }
      class RegisterLoanRequest <<Request>> {
        +type: string
        +counterparty: string
        +principal: number
        +currency: string
        +interestRate: number
        +disbursedOn: string
        +bankAccountId: number
      }
      class LoansApiEndpoint {
        +register(command: RegisterLoanCommand): Observable<Loan>
        +schedule(loanId: number, dueOn: string, principal: number, interest: number): Observable<Loan>
        +pay(loanId: number, installmentId: number, paidOn: string, bankAccountId: number): Observable<Loan>
      }
      note right of LoansApiEndpoint
        Implementado: getAll() y register(). schedule() y pay() llegan con el detalle del préstamo:
        POST /loans/{id}/installments y POST /loans/{id}/installments/{iid}/payments responden con el
        préstamo completo; no existe un GET de cuotas.
      end note
      class PartnersApiEndpoint {
      }
      class PartnerContributionsApiEndpoint {
        +getByPeriod(year: number, month: number): Observable<PartnerContribution[]>
        +register(partnerId: number, contribution: PartnerContribution): Observable<PartnerContribution>
      }

      class TreasuryApi {
        -bankAccountsEndpoint: BankAccountsApiEndpoint
        -payablesEndpoint: PayablesApiEndpoint
        -loansEndpoint: LoansApiEndpoint
        -partnersEndpoint: PartnersApiEndpoint
        -partnerContributionsEndpoint: PartnerContributionsApiEndpoint
        +getBankAccounts(): Observable<BankAccount[]>
        +openBankAccount(command: OpenBankAccountCommand): Observable<BankAccount>
        +getBankAccountById(id: number): Observable<BankAccount>
        +getMovements(bankAccountId: number, year: number, month: number): Observable<CashMovement[]>
        +registerAdjustment(bankAccountId: number, command: RegisterAdjustmentCommand): Observable<BankAccount>
        +transferFunds(command: TransferFundsCommand): Observable<BankAccount>
        +getPayables(): Observable<Payable[]>
        +createPayable(command: CreatePayableCommand): Observable<Payable>
        +payPayable(id: number, command: RegisterPayablePaymentCommand): Observable<Payable>
        +reschedulePayable(id: number, week: CashFlowWeek): Observable<Payable>
        +getLoans(): Observable<Loan[]>
        +getLoanById(id: number): Observable<Loan>
        +registerLoan(command: RegisterLoanCommand): Observable<Loan>
        +scheduleInstallment(loanId: number, dueOn: string, principal: number, interest: number): Observable<Loan>
        +payInstallment(loanId: number, installmentId: number, paidOn: string, bankAccountId: number): Observable<Loan>
        +getPartners(): Observable<Partner[]>
        +registerPartner(partner: Partner): Observable<Partner>
        +registerContribution(partnerId: number, contribution: PartnerContribution): Observable<PartnerContribution>
        +getContributionsByPeriod(year: number, month: number): Observable<PartnerContribution[]>
      }

      BankAccountResource ..|> app.shared.infrastructure.BaseResource : implements
      CashMovementResource ..|> app.shared.infrastructure.BaseResource : implements
      PayableResource ..|> app.shared.infrastructure.BaseResource : implements
      LoanResource ..|> app.shared.infrastructure.BaseResource : implements
      PartnerResource ..|> app.shared.infrastructure.BaseResource : implements
      PartnerContributionResource ..|> app.shared.infrastructure.BaseResource : implements
      BankAccountsResponse ..|> app.shared.infrastructure.BaseResponse : implements
      PayablesResponse ..|> app.shared.infrastructure.BaseResponse : implements
      LoansResponse ..|> app.shared.infrastructure.BaseResponse : implements
      PartnersResponse ..|> app.shared.infrastructure.BaseResponse : implements
      PartnerContributionsResponse ..|> app.shared.infrastructure.BaseResponse : implements
      BankAccountAssembler ..|> app.shared.infrastructure.BaseAssembler : implements
      PayableAssembler ..|> app.shared.infrastructure.BaseAssembler : implements
      LoanAssembler ..|> app.shared.infrastructure.BaseAssembler : implements
      PartnerAssembler ..|> app.shared.infrastructure.BaseAssembler : implements
      PartnerContributionAssembler ..|> app.shared.infrastructure.BaseAssembler : implements
      BankAccountsApiEndpoint --|> app.shared.infrastructure.BaseApiEndpoint : extends
      PayablesApiEndpoint --|> app.shared.infrastructure.BaseApiEndpoint : extends
      LoansApiEndpoint --|> app.shared.infrastructure.BaseApiEndpoint : extends
      PartnersApiEndpoint --|> app.shared.infrastructure.BaseApiEndpoint : extends
      PartnerContributionsApiEndpoint --|> app.shared.infrastructure.BaseApiEndpoint : extends
      TreasuryApi --|> app.shared.infrastructure.BaseApi : extends
      TreasuryApi --> BankAccountsApiEndpoint : delegates to
      TreasuryApi --> PayablesApiEndpoint : delegates to
      TreasuryApi --> LoansApiEndpoint : delegates to
      TreasuryApi --> PartnersApiEndpoint : delegates to
      TreasuryApi --> PartnerContributionsApiEndpoint : delegates to
      BankAccountsApiEndpoint --> BankAccountAssembler : uses
      BankAccountsApiEndpoint --> CashMovementAssembler : uses
      PayablesApiEndpoint --> PayableAssembler : uses
      LoansApiEndpoint --> LoanAssembler : uses
      LoansApiEndpoint ..> RegisterLoanCommand : sends
      PartnersApiEndpoint --> PartnerAssembler : uses
      PartnerContributionsApiEndpoint --> PartnerContributionAssembler : uses
      BankAccountsApiEndpoint ..> TransferFundsCommand : sends
      BankAccountsApiEndpoint ..> RegisterAdjustmentCommand : sends
    }

    package "application" {
      class TreasuryStore <<Store>> {
        -treasuryApi: TreasuryApi
        -bankAccountsSignal: WritableSignal<BankAccount[]>
        -movementsSignal: WritableSignal<CashMovement[]>
        -payablesSignal: WritableSignal<Payable[]>
        -loansSignal: WritableSignal<Loan[]>
        -partnersSignal: WritableSignal<Partner[]>
        -contributionsSignal: WritableSignal<PartnerContribution[]>
        -loadingSignal: WritableSignal<boolean>
        -errorSignal: WritableSignal<string | null>
        +bankAccounts: Signal<BankAccount[]>
        +totalBalance: Signal<number>
        +canWrite: Signal<boolean>
        +movements: Signal<CashMovement[]>
        +movementTotals: Signal<{inflows: number, outflows: number}>
        +payables: Signal<Payable[]>
        +outstandingPayables: Signal<number>
        +loans: Signal<Loan[]>
        +partners: Signal<Partner[]>
        +contributions: Signal<PartnerContribution[]>
        +loading: Signal<boolean>
        +error: Signal<string | null>
        +loadBankAccounts(): void
        +openBankAccount(command: OpenBankAccountCommand, navigateTo: string[]): void
        +loadBankAccount(id: number): void
        +loadMovements(bankAccountId: number, period: Period): void
        +registerAdjustment(bankAccountId: number, command: RegisterAdjustmentCommand): void
        +transferFunds(command: TransferFundsCommand): void
        +loadPayables(): void
        +createPayable(command: CreatePayableCommand, navigateTo: string[]): void
        +payPayable(id: number, command: RegisterPayablePaymentCommand): void
        +reschedulePayable(id: number, week: CashFlowWeek): void
        +countPayablesByStatus(status: PaymentStatus | null): number
        +loadLoans(): void
        +registerLoan(command: RegisterLoanCommand, navigateTo: string[]): void
        +countLoansByType(type: LoanType | null): number
        +loadLoan(loanId: number): void
        +scheduleInstallment(loanId: number, dueOn: string, principal: number, interest: number): void
        +payInstallment(loanId: number, installmentId: number, paidOn: string, bankAccountId: number): void
        +loadPartners(): void
        +registerPartner(partner: Partner): void
        +registerContribution(partnerId: number, contribution: PartnerContribution): void
        +getBankAccountById(id: number): BankAccount | undefined
      }
      TreasuryStore --> TreasuryApi : uses
      TreasuryStore --> BankAccount : manages
      TreasuryStore --> CashMovement : manages
      TreasuryStore --> Payable : manages
      TreasuryStore --> Loan : manages
      TreasuryStore --> Partner : manages
      TreasuryStore --> PartnerContribution : manages
    }

    package "presentation" {
      package "components" {
        class TransferFundsDialog <<Component>> {
          -formBuilder: FormBuilder
          -dialogRef: MatDialogRef<TransferFundsDialog>
          +data: {accounts: BankAccount[], fromAccountId: number | null}
          +transferForm: FormGroup
          +targets: Signal<BankAccount[]>
          +leavesNegative: Signal<boolean>
          +onSave(): void
          +onCancel(): void
        }
        class RegisterAdjustmentDialog <<Component>> {
          -formBuilder: FormBuilder
          -dialogRef: MatDialogRef<RegisterAdjustmentDialog>
          +account: BankAccount
          +adjustmentForm: FormGroup
          +onSave(): void
          +onCancel(): void
        }
        class RegisterPayablePaymentDialog <<Component>> {
          -formBuilder: FormBuilder
          -dialogRef: MatDialogRef<RegisterPayablePaymentDialog>
          +data: {payable: Payable, bankAccounts: BankAccount[]}
          +accounts: BankAccount[]
          +paymentForm: FormGroup
          +onSave(): void
          +onCancel(): void
        }
        class ReschedulePayableDialog <<Component>> {
          -formBuilder: FormBuilder
          -dialogRef: MatDialogRef<ReschedulePayableDialog>
          +payable: Payable
          +week: Signal<CashFlowWeek | null>
          +onSave(): void
          +onCancel(): void
        }
        class ScheduleInstallmentDialog <<Component>> {
          -formBuilder: FormBuilder
          -dialogRef: MatDialogRef<ScheduleInstallmentDialog>
          +data: {loan: Loan}
          +installmentForm: FormGroup
          +onSave(): void
          +onCancel(): void
        }
        class PayInstallmentDialog <<Component>> {
          -formBuilder: FormBuilder
          -dialogRef: MatDialogRef<PayInstallmentDialog>
          +data: {installment: LoanInstallment, accounts: BankAccount[]}
          +paymentForm: FormGroup
          +onSave(): void
          +onCancel(): void
        }
        class RegisterContributionDialog <<Component>> {
          -formBuilder: FormBuilder
          -dialogRef: MatDialogRef<RegisterContributionDialog>
          +data: {partner: Partner, accounts: BankAccount[]}
          +contributionForm: FormGroup
          +onSave(): void
          +onCancel(): void
        }
      }

      package "views" {
        class BankAccountList <<Component>> {
          -treasuryStore: TreasuryStore
          -dialog: MatDialog
          -router: Router
          +accounts: Signal<BankAccount[]>
          +totalBalance: Signal<number>
          +canWrite: Signal<boolean>
          +tone(account: BankAccount): string
          +icon(account: BankAccount): string
          +onTransfer(): void
        }
        class BankAccountForm <<Component>> {
          -formBuilder: FormBuilder
          -treasuryStore: TreasuryStore
          -router: Router
          +accountForm: FormGroup
          +banks: Bank[]
          +types: AccountType[]
          +onSubmit(): void
          +onCancel(): void
        }
        class BankAccountDetail <<Component>> {
          -treasuryStore: TreasuryStore
          -dialog: MatDialog
          +id: InputSignal<string>
          +account: Signal<BankAccount | undefined>
          +period: WritableSignal<Period>
          +totals: Signal<{inflows: number, outflows: number}>
          +columns: string[]
          +dataSource: Signal<MatTableDataSource<CashMovement>>
          +paginator: Signal<MatPaginator>
          +onAdjust(account: BankAccount): void
          +onTransfer(account: BankAccount): void
        }
        class PayableList <<Component>> {
          -treasuryStore: TreasuryStore
          -expensesStore: ExpensesStore
          -projectsStore: ProjectsStore
          -dialog: MatDialog
          +displayedColumns: Signal<string[]>
          +dataSource: Signal<MatTableDataSource<Payable>>
          +paginator: Signal<MatPaginator>
          +sort: Signal<MatSort>
          +outstanding: Signal<number>
          +statusFilter: WritableSignal<PaymentStatus | null>
          +weekLabel(payable: Payable): string
          +onRegisterPayment(payable: Payable): void
          +onReschedule(payable: Payable): void
        }
        class PayableForm <<Component>> {
          -formBuilder: FormBuilder
          -treasuryStore: TreasuryStore
          -expensesStore: ExpensesStore
          -projectsStore: ProjectsStore
          -router: Router
          +payableForm: FormGroup
          +types: PayableType[]
          +years: number[]
          +months: number[]
          +weeks: Signal<CashFlowWeek[]>
          +onSubmit(): void
          +onCancel(): void
        }
        class LoanList <<Component>> {
          -treasuryStore: TreasuryStore
          -translate: TranslateService
          +displayedColumns: string[]
          +dataSource: Signal<MatTableDataSource<Loan>>
          +sort: Signal<MatSort>
          +paginator: Signal<MatPaginator>
          +types: (LoanType | null)[]
          +typeFilter: WritableSignal<LoanType | null>
          +canWrite: Signal<boolean>
          +count(type: LoanType | null): number
          +rateLabel(loan: Loan): string
          +accountLabel(loan: Loan): string
        }
        class LoanForm <<Component>> {
          -formBuilder: FormBuilder
          -treasuryStore: TreasuryStore
          -router: Router
          +loanForm: FormGroup
          +types: LoanType[]
          +accounts: Signal<BankAccount[]>
          +isReceived: Signal<boolean>
          +negativeBalance: Signal<number | null>
          +accountLabel(account: BankAccount): string
          +onSubmit(): void
          +onCancel(): void
        }
        class LoanDetail <<Component>> {
          -treasuryStore: TreasuryStore
          -dialog: MatDialog
          -route: ActivatedRoute
          +loan: Signal<Loan | undefined>
          +installments: Signal<LoanInstallment[]>
          +onScheduleInstallment(): void
          +onPayInstallment(installment: LoanInstallment): void
        }
        class PartnerList <<Component>> {
          -treasuryStore: TreasuryStore
          -dialog: MatDialog
          +partners: Signal<Partner[]>
          +period: WritableSignal<Period>
          +contributions: Signal<PartnerContribution[]>
          +onRegisterContribution(partner: Partner): void
          +onAdd(): void
        }
      }

      BankAccountList --> TreasuryStore : uses
      BankAccountForm --> TreasuryStore : uses
      BankAccountDetail --> TreasuryStore : uses
      PayableList --> TreasuryStore : uses
      PayableForm --> TreasuryStore : uses
      LoanList --> TreasuryStore : uses
      LoanForm --> TreasuryStore : uses
      LoanDetail --> TreasuryStore : uses
      PartnerList --> TreasuryStore : uses
      BankAccountForm --|> app.shared.presentation.BaseForm : extends
      PayableForm --|> app.shared.presentation.BaseForm : extends
      LoanForm --|> app.shared.presentation.BaseForm : extends
      BankAccountList --> TransferFundsDialog : opens
      BankAccountDetail --> TransferFundsDialog : opens
      BankAccountDetail --> RegisterAdjustmentDialog : opens
      BankAccountDetail --> app.shared.presentation.components.PeriodSelector : contains
      PayableList --> RegisterPayablePaymentDialog : opens
      PayableList --> ReschedulePayableDialog : opens
      LoanDetail --> ScheduleInstallmentDialog : opens
      LoanDetail --> PayInstallmentDialog : opens
      PartnerList --> RegisterContributionDialog : opens
      BankAccountDetail --> app.shared.presentation.components.PeriodSelector : contains
      PartnerList --> app.shared.presentation.components.PeriodSelector : contains
      PayableList --> app.shared.presentation.components.StatusChip : contains
      LoanList --> app.shared.presentation.components.StatusChip : contains
    }
  }
}

note bottom
  El saldo de cada cuenta (currentBalance) lo calcula el backend a partir de los movimientos;
  la UI nunca lo edita a mano (en el Excel se tipeaba). TreasuryStore expone bankAccounts
  y partners como lectura para billing, expenses y staff (selección de cuenta / socio).
  Abrir cuenta (POST /bank-accounts): número único 1 a 50 (409), saldo inicial >= 0, fecha de apertura
  obligatoria (el backend la pide aunque no la devuelve) y solo PEN por ahora (USD -> 422).
  Lectura: ADMIN, ACCOUNTING, MANAGEMENT. Escritura: ADMIN, ACCOUNTING (AREA_ROLES.treasuryWrite).
  El backend no impide saldos negativos; la UI los marca en rojo.
  Movimientos por mes: GET /bank-accounts/{id}/movements?year=&month= (sin orden: la UI ordena por fecha).
  El saldo inicial no es un movimiento; saldo actual = inicial + movimientos. No hay saldo por fila.
  TransferFundsDialog solo ofrece destinos distintos y de la misma moneda (POST /bank-accounts/transfers);
  el backend responde con la cuenta de origen, así que tras transferir se releen todos los saldos.
  Ajuste (POST /bank-accounts/{id}/adjustments): única forma de corregir un saldo; el tipo no tiene valor
  por defecto. Ojo: los movimientos automáticos llegan con concepto en inglés desde el backend.
  Cuentas por pagar: GET /payables (más antigua primero); pagar POST /payables/{id}/payments exige cuenta y
  no más que el saldo (409); genera la salida de caja y, si salda la de un gasto, marca el gasto pagado.
  Reprogramar PUT /payables/{id}/schedule {year, month, week 1..6} (se elige una fecha y se muestra su semana).
  Un gasto pendiente crea su cuenta por pagar ("Expense <id>", sin proveedor); anularlo la borra si no tiene
  pagos, y si los tiene el backend responde 409. PaymentStatus vive en shared (Gastos y Tesorería).
  Nueva cuenta por pagar (POST /payables): semana como año, mes y semana del mes (las opciones salen del mes,
  con sus fechas). Contabilidad registra su costo salvo TAX y SELF_DETRACTION: una compra con comprobante va
  en Gastos como pendiente (crea su cuenta por pagar sola); el formulario lo avisa y nunca envía expenseId.
  Préstamos: GET /loans (?type=RECEIVED|GRANTED) y POST /loans; solo PEN en la práctica (el backend compara la
  moneda con la de la cuenta, que hoy siempre es PEN). Registrar mueve caja en la cuenta elegida el día del
  desembolso: recibido = ingreso, otorgado = egreso ("Loan disbursement: <contraparte>"). El backend no
  impide que un otorgado deje la cuenta en negativo: el formulario solo avisa. La tasa se escribe como
  porcentaje anual (0 a 100 con 2 decimales, tope propio de la UI) y viaja como fracción.
  El saldo pendiente es el capital menos el capital de las cuotas pagadas; el estado pasa a PARTIALLY_PAID
  con la primera cuota pagada y a PAID cuando el saldo llega a cero.
  json-server: rutas propias en server/routes/treasury.js con las reglas y mensajes del backend.
end note
