@startuml
' Brasper Platform Frontend - Staff Bounded Context (Angular 22 + Angular Material)

skinparam classAttributeIconSize 0
hide empty members

package "app" {

  package "shared" {
    package "domain.model" {
      interface BaseEntity
    }
    package "infrastructure" {
      interface BaseResource
      interface BaseResponse
      interface BaseAssembler<TEntity, TResource, TResponse>
      abstract class BaseApiEndpoint<TEntity, TResource, TResponse, TAssembler>
      abstract class BaseApi
    }
    package "presentation" {
      abstract class BaseForm
      package "components" {
        class PeriodSelector <<Component>>
        class ConfirmDialog <<Component>>
      }
    }
  }

  package "treasury" {
    package "application" {
      class TreasuryStore <<Store>>
    }
  }

  ' ==========================================
  ' STAFF BOUNDED CONTEXT
  ' ==========================================
  package "staff" {
    package "domain.model" {
      class Employee <<Entity>> {
        - #id: number
        - #fullName: string
        - #dni: string
        - #position: string
        - #monthlySalary: number
        - #currency: string
        - #hiredOn: string
        - #terminatedOn: string | null
        - #active: boolean
        +id: number
        +fullName: string
        +dni: string
        +position: string
        +monthlySalary: number
        +currency: string
        +hiredOn: string
        +terminatedOn: string | null
        +active: boolean
        +isActive(): boolean
      }
      Employee ..|> app.shared.domain.model.BaseEntity : implements

      class FixedCost <<Entity>> {
        - #id: number
        - #code: string
        - #concept: string
        - #type: FixedCostType
        - #monthlyAmount: number
        - #currency: string
        - #employeeId: number | null
        - #expectedWeeks: number[]
        - #active: boolean
        +id: number
        +code: string
        +concept: string
        +type: FixedCostType
        +monthlyAmount: number
        +currency: string
        +employeeId: number | null
        +expectedWeeks: number[]
        +active: boolean
        +isActive(): boolean
      }
      FixedCost ..|> app.shared.domain.model.BaseEntity : implements
      Employee "0..1" <-- "*" FixedCost : references employeeId

      enum FixedCostType {
        SALARY
        OVERTIME
        ACCOUNTING
        SCTR_INSURANCE
        LIFE_INSURANCE
        OFFICE_RENT
        CLEANING
        BANK_FEES
        ITF
        HOSTING
        ADMINISTRATIVE
      }
      FixedCost --> FixedCostType : has

      class FixedCostPayment <<Entity>> {
        - #id: number
        - #fixedCostId: number
        - #paidOn: string
        - #year: number
        - #month: number
        - #amount: number
        - #currency: string
        - #bankAccountId: number | null
        - #notes: string
        +id: number
        +fixedCostId: number
        +paidOn: string
        +year: number
        +month: number
        +amount: number
        +currency: string
        +bankAccountId: number | null
        +notes: string
      }
      FixedCostPayment ..|> app.shared.domain.model.BaseEntity : implements
      FixedCost "1" <-- "*" FixedCostPayment : references fixedCostId
    }

    package "infrastructure" {
      class EmployeeResource <<Resource>> {
        +id: number
        +fullName: string
        +dni: string
        +position: string
        +monthlySalary: number
        +currency: string
        +hiredOn: string
        +terminatedOn: string | null
        +active: boolean
      }
      class HireEmployeeRequest <<Request>> {
        +fullName: string
        +dni: string
        +position: string | null
        +monthlySalary: number
        +currency: string
        +hiredOn: string
      }
      class UpdateEmployeeRequest <<Request>> {
        +position: string | null
        +monthlySalary: number
        +currency: string
      }
      class FixedCostResource <<Resource>> {
        +id: number
        +code: string
        +concept: string
        +type: string
        +monthlyAmount: number
        +currency: string
        +employeeId: number | null
        +expectedWeeks: number[]
        +active: boolean
      }
      class CreateFixedCostRequest <<Request>> {
        +code: string
        +concept: string
        +type: string
        +monthlyAmount: number
        +currency: string
        +employeeId: number | null
        +expectedWeeks: number[]
      }
      class UpdateFixedCostRequest <<Request>> {
        +concept: string
        +monthlyAmount: number
        +expectedWeeks: number[]
      }
      class RegisterFixedCostPaymentRequest <<Request>> {
        +paidOn: string
        +year: number
        +month: number
        +amount: number
        +bankAccountId: number | null
        +notes: string | null
      }
      class FixedCostPaymentResource <<Resource>> {
        +id: number
        +fixedCostId: number
        +paidOn: string
        +year: number
        +month: number
        +amount: number
        +currency: string
        +bankAccountId: number | null
        +notes: string | null
      }
      class EmployeesResponse <<Response>> {
      }
      class FixedCostsResponse <<Response>> {
      }
      class FixedCostPaymentsResponse <<Response>> {
      }

      class EmployeeAssembler <<Assembler>> {
        +toEntitiesFromResponse(response: EmployeesResponse): Employee[]
        +toEntityFromResource(resource: EmployeeResource): Employee
        +toResourceFromEntity(entity: Employee): EmployeeResource
      }
      class FixedCostAssembler <<Assembler>> {
        +toEntitiesFromResponse(response: FixedCostsResponse): FixedCost[]
        +toEntityFromResource(resource: FixedCostResource): FixedCost
        +toResourceFromEntity(entity: FixedCost): FixedCostResource
      }
      class FixedCostPaymentAssembler <<Assembler>> {
        +toEntitiesFromResponse(response: FixedCostPaymentsResponse): FixedCostPayment[]
        +toEntityFromResource(resource: FixedCostPaymentResource): FixedCostPayment
        +toResourceFromEntity(entity: FixedCostPayment): FixedCostPaymentResource
      }

      class EmployeesApiEndpoint {
        +hire(command: HireEmployeeCommand): Observable<Employee>
        +updateEmployee(id: number, command: UpdateEmployeeCommand): Observable<Employee>
        +terminate(id: number, terminatedOn: string): Observable<Employee>
      }
      class FixedCostsApiEndpoint {
        +createFixedCost(command: CreateFixedCostCommand): Observable<FixedCost>
        +updateFixedCost(id: number, command: UpdateFixedCostCommand): Observable<FixedCost>
        +deactivate(id: number): Observable<FixedCost>
      }
      class FixedCostPaymentsApiEndpoint {
        +getByPeriod(year: number, month: number): Observable<FixedCostPayment[]>
        +register(fixedCostId: number, command: RegisterFixedCostPaymentCommand): Observable<FixedCostPayment>
      }

      class StaffApi {
        -employeesEndpoint: EmployeesApiEndpoint
        -fixedCostsEndpoint: FixedCostsApiEndpoint
        -fixedCostPaymentsEndpoint: FixedCostPaymentsApiEndpoint
        +getEmployees(): Observable<Employee[]>
        +getEmployeeById(id: number): Observable<Employee>
        +hireEmployee(command: HireEmployeeCommand): Observable<Employee>
        +updateEmployee(id: number, command: UpdateEmployeeCommand): Observable<Employee>
        +terminateEmployee(id: number, terminatedOn: string): Observable<Employee>
        +getFixedCosts(): Observable<FixedCost[]>
        +getFixedCostById(id: number): Observable<FixedCost>
        +createFixedCost(command: CreateFixedCostCommand): Observable<FixedCost>
        +updateFixedCost(id: number, command: UpdateFixedCostCommand): Observable<FixedCost>
        +deactivateFixedCost(id: number): Observable<FixedCost>
        +getPaymentsByPeriod(year: number, month: number): Observable<FixedCostPayment[]>
        +registerPayment(fixedCostId: number, command: RegisterFixedCostPaymentCommand): Observable<FixedCostPayment>
      }

      EmployeeResource ..|> app.shared.infrastructure.BaseResource : implements
      FixedCostResource ..|> app.shared.infrastructure.BaseResource : implements
      FixedCostPaymentResource ..|> app.shared.infrastructure.BaseResource : implements
      EmployeesResponse ..|> app.shared.infrastructure.BaseResponse : implements
      FixedCostsResponse ..|> app.shared.infrastructure.BaseResponse : implements
      FixedCostPaymentsResponse ..|> app.shared.infrastructure.BaseResponse : implements
      EmployeeAssembler ..|> app.shared.infrastructure.BaseAssembler : implements
      FixedCostAssembler ..|> app.shared.infrastructure.BaseAssembler : implements
      FixedCostPaymentAssembler ..|> app.shared.infrastructure.BaseAssembler : implements
      EmployeesApiEndpoint --|> app.shared.infrastructure.BaseApiEndpoint : extends
      FixedCostsApiEndpoint --|> app.shared.infrastructure.BaseApiEndpoint : extends
      FixedCostPaymentsApiEndpoint --|> app.shared.infrastructure.BaseApiEndpoint : extends
      StaffApi --|> app.shared.infrastructure.BaseApi : extends
      StaffApi --> EmployeesApiEndpoint : delegates to
      StaffApi --> FixedCostsApiEndpoint : delegates to
      StaffApi --> FixedCostPaymentsApiEndpoint : delegates to
      EmployeesApiEndpoint --> EmployeeAssembler : uses
      FixedCostsApiEndpoint --> FixedCostAssembler : uses
      FixedCostPaymentsApiEndpoint --> FixedCostPaymentAssembler : uses
    }

    package "application" {
      class StaffStore <<Store>> {
        -staffApi: StaffApi
        -employeesSignal: WritableSignal<Employee[]>
        -fixedCostsSignal: WritableSignal<FixedCost[]>
        -paymentsSignal: WritableSignal<FixedCostPayment[]>
        -loadingSignal: WritableSignal<boolean>
        -errorSignal: WritableSignal<string | null>
        +employees: Signal<Employee[]>
        +activeEmployees: Signal<Employee[]>
        +fixedCosts: Signal<FixedCost[]>
        +activeFixedCosts: Signal<FixedCost[]>
        +monthlyFixedCostTotal: Signal<number>
        +payments: Signal<FixedCostPayment[]>
        +loading: Signal<boolean>
        +error: Signal<string | null>
        +canWrite: Signal<boolean>
        +paidInPeriod: Signal<number>
        +pendingInPeriod: Signal<number>
        +loadEmployees(): void
        +loadEmployee(id: number): void
        +loadFixedCosts(): void
        +loadPayments(year: number, month: number): void
        +hireEmployee(command: HireEmployeeCommand, navigateTo: string[]): void
        +updateEmployee(id: number, command: UpdateEmployeeCommand, navigateTo: string[]): void
        +terminateEmployee(id: number, terminatedOn: string): void
        +createFixedCost(command: CreateFixedCostCommand, navigateTo: string[]): void
        +updateFixedCost(id: number, command: UpdateFixedCostCommand, navigateTo: string[]): void
        +deactivateFixedCost(id: number): void
        +registerPayment(fixedCostId: number, command: RegisterFixedCostPaymentCommand): void
        +paidAmount(fixedCostId: number): number
        +pendingAmount(fixedCostId: number): number
        +getEmployeeById(id: number): Employee | undefined
        +getFixedCostById(id: number): FixedCost | undefined
      }
      StaffStore --> StaffApi : uses
      StaffStore --> Employee : manages
      StaffStore --> FixedCost : manages
      StaffStore --> FixedCostPayment : manages
    }

    package "presentation" {
      package "components" {
        class TerminateEmployeeDialog <<Component>> {
          -formBuilder: FormBuilder
          -dialogRef: MatDialogRef<TerminateEmployeeDialog>
          +employee: Employee
          +terminationForm: FormGroup
          +onConfirm(): void
          +onCancel(): void
        }
        class RegisterFixedCostPaymentDialog <<Component>> {
          -formBuilder: FormBuilder
          -dialogRef: MatDialogRef<RegisterFixedCostPaymentDialog>
          -treasuryStore: TreasuryStore
          +data: {fixedCost: FixedCost, year: number, month: number}
          +paymentForm: FormGroup
          +bankAccounts: Signal<BankAccount[]>
          +onSave(): void
          +onCancel(): void
        }
      }

      package "views" {
        class EmployeeList <<Component>> {
          -staffStore: StaffStore
          -dialog: MatDialog
          -router: Router
          +displayedColumns: string[]
          +dataSource: Signal<MatTableDataSource<Employee>>
          +paginator: Signal<MatPaginator>
          +sort: Signal<MatSort>
          +onTerminate(employee: Employee): void
        }
        class EmployeeForm <<Component>> {
          -formBuilder: FormBuilder
          -staffStore: StaffStore
          -router: Router
          -route: ActivatedRoute
          +employeeForm: FormGroup
          +isEdit: boolean
          +onSubmit(): void
          +onCancel(): void
        }
        class FixedCostList <<Component>> {
          -staffStore: StaffStore
          -dialog: MatDialog
          -router: Router
          +period: WritableSignal<Period>
          +displayedColumns: string[]
          +dataSource: Signal<MatTableDataSource<FixedCost>>
          +paginator: Signal<MatPaginator>
          +sort: Signal<MatSort>
          +getEmployeeName(employeeId: number | null): string
          +onEdit(id: number): void
          +onDeactivate(id: number): void
          +onRegisterPayment(fixedCost: FixedCost): void
          +onAdd(): void
        }
        class FixedCostForm <<Component>> {
          -formBuilder: FormBuilder
          -staffStore: StaffStore
          -router: Router
          -route: ActivatedRoute
          +fixedCostForm: FormGroup
          +employees: Signal<Employee[]>
          +types: FixedCostType[]
          +isEdit: boolean
          +onSubmit(): void
          +onCancel(): void
        }
      }

      EmployeeList --> StaffStore : uses
      EmployeeForm --> StaffStore : uses
      FixedCostList --> StaffStore : uses
      FixedCostForm --> StaffStore : uses
      EmployeeForm --|> app.shared.presentation.BaseForm : extends
      FixedCostForm --|> app.shared.presentation.BaseForm : extends
      FixedCostList --> RegisterFixedCostPaymentDialog : opens
      FixedCostList --> app.shared.presentation.components.PeriodSelector : contains
      EmployeeList --> TerminateEmployeeDialog : opens
      FixedCostList --> app.shared.presentation.components.ConfirmDialog : opens
      RegisterFixedCostPaymentDialog --> app.treasury.application.TreasuryStore : reads bank accounts
    }
  }
}

note bottom
  FixedCostForm: si type = SALARY el empleado es obligatorio; expectedWeeks (1..5) indica en qué
  semanas del mes se espera pagar (alimenta el flujo de caja proyectado).
  FixedCostList muestra por período lo pagado vs. pendiente (pendingAmount).
  Los gastos de proyecto NO se registran aquí, sino en expenses.
  Empleado: al editar solo cambian cargo y sueldo (PUT); nombre, DNI (8 dígitos, único) e ingreso no.
  La baja pide fecha (POST /employees/{id}/termination {terminatedOn}), no puede ser anterior al ingreso
  y no se deshace; un cesado no se edita ni se vuelve a dar de baja (409).
  Costo fijo: código único (1 a 30), SALARY exige empleado; al editar solo concepto, monto y semanas
  (código, tipo y empleado fijos). Desactivar (POST /{id}/deactivate) no tiene vuelta atrás; uno inactivo
  no se edita ni recibe pagos (409). Pagos: POST /fixed-costs/{id}/payments (cuenta opcional: sin cuenta
  no hay salida de caja) y GET /fixed-costs/payments?year=&month=. Solo PEN.
  Lectura: ADMIN, ACCOUNTING, MANAGEMENT. Escritura: ADMIN, ACCOUNTING.
end note
@enduml
