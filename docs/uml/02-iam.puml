@startuml
' Brasper Platform - IAM Bounded Context

skinparam classAttributeIconSize 0
set separator none

package "IAM" {

  package "Interfaces.REST" {
    class AuthenticationController {
      +SignIn(SignInResource, CancellationToken) : Task<ActionResult>
      +SignUp(SignUpResource, CancellationToken) : Task<ActionResult>
    }

    class UsersController {
      +GetAllUsers(CancellationToken) : Task<ActionResult>
      +GetUserById(int, CancellationToken) : Task<ActionResult>
      +ChangeUserRole(int, ChangeUserRoleResource, CancellationToken) : Task<ActionResult>
      +DeactivateUser(int, CancellationToken) : Task<ActionResult>
    }

    package "Resources" {
      class SignInResource <<resource>> {
        +string Username
        +string Password
      }

      class SignUpResource <<resource>> {
        +string Username
        +string Password
        +string FullName
        +string Role
      }

      class AuthenticatedUserResource <<resource>> {
        +int Id
        +string Username
        +string Role
        +string Token
      }

      class UserResource <<resource>> {
        +int Id
        +string Username
        +string FullName
        +string Role
        +bool IsActive
      }

      class ChangeUserRoleResource <<resource>> {
        +string Role
      }
    }

    package "Transform" {
      class SignInCommandFromResourceAssembler <<assembler>> {
        +ToCommandFromResource(SignInResource) : SignInCommand
      }

      class SignUpCommandFromResourceAssembler <<assembler>> {
        +ToCommandFromResource(SignUpResource) : SignUpCommand
      }

      class AuthenticatedUserResourceFromEntityAssembler <<assembler>> {
        +ToResourceFromEntity(AuthenticatedUser) : AuthenticatedUserResource
      }

      class UserResourceFromEntityAssembler <<assembler>> {
        +ToResourceFromEntity(User) : UserResource
      }
    }
  }

  package "Interfaces.ACL" {
    interface IIamContextFacade <<facade>> {
      +ExistsUserById(int, CancellationToken) : Task<bool>
      +FetchUsernameById(int, CancellationToken) : Task<string?>
    }
  }

  package "Domain.Model" {
    package "ValueObjects" {
      class Username <<value-object>> {
        +string Value
        +Username(string)
      }

      enum Role <<value-object>> {
        Admin
        Management
        Accounting
        Engineer
      }
    }

    package "Commands" {
      class SignInCommand <<command>> {
        +Username Username
        +string Password
      }

      class SignUpCommand <<command>> {
        +Username Username
        +string Password
        +string FullName
        +Role Role
      }

      class ChangeUserRoleCommand <<command>> {
        +int UserId
        +Role Role
      }

      class DeactivateUserCommand <<command>> {
        +int UserId
      }
    }

    package "Queries" {
      class GetAllUsersQuery <<query>>

      class GetUserByIdQuery <<query>> {
        +int Id
      }

      class GetUserByUsernameQuery <<query>> {
        +Username Username
      }
    }

    package "ReadModels" {
      class AuthenticatedUser <<read-model>> {
        +User User
        +string Token
      }
    }

    package "Aggregates" {
      class User <<aggregate>> {
        +int Id
        +Username Username
        +string PasswordHash
        +string FullName
        +Role Role
        +bool IsActive
        +User(SignUpCommand, string)
        +ChangeRole(Role) : void
        +Deactivate() : void
      }
    }
  }

  package "Domain.Repositories" {
    interface IUserRepository <<repository>> {
      +FindByUsernameAsync(Username, CancellationToken) : Task<User?>
      +ExistsByUsernameAsync(Username, CancellationToken) : Task<bool>
    }
  }

  package "Application" {
    package "Errors" {
      enum SignInError <<error>> {
        InvalidCredentials
        UserInactive
        UnexpectedError
      }

      enum SignUpError <<error>> {
        InvalidUsername
        WeakPassword
        DuplicateUsername
        UnexpectedError
      }

      enum UpdateUserError <<error>> {
        UserNotFound
        CannotModifyLastAdmin
        UnexpectedError
      }
    }

    package "Services" {
      interface IUserCommandService <<application-service>> {
        +Handle(SignInCommand, CancellationToken) : Task<Result<AuthenticatedUser, SignInError>>
        +Handle(SignUpCommand, CancellationToken) : Task<Result<User, SignUpError>>
        +Handle(ChangeUserRoleCommand, CancellationToken) : Task<Result<User, UpdateUserError>>
        +Handle(DeactivateUserCommand, CancellationToken) : Task<Result<User, UpdateUserError>>
      }

      interface IUserQueryService <<application-service>> {
        +Handle(GetAllUsersQuery, CancellationToken) : Task<IEnumerable<User>>
        +Handle(GetUserByIdQuery, CancellationToken) : Task<User?>
        +Handle(GetUserByUsernameQuery, CancellationToken) : Task<User?>
      }
    }

    package "OutboundServices" {
      interface IHashingService <<outbound-service>> {
        +HashPassword(string) : string
        +VerifyPassword(string, string) : bool
      }

      interface ITokenService <<outbound-service>> {
        +GenerateToken(User) : string
        +ValidateToken(string) : Task<int?>
      }
    }

    package "Internal.CommandServices" {
      class UserCommandService <<service>> {
        +Handle(SignInCommand, CancellationToken) : Task<Result<AuthenticatedUser, SignInError>>
        +Handle(SignUpCommand, CancellationToken) : Task<Result<User, SignUpError>>
        +Handle(ChangeUserRoleCommand, CancellationToken) : Task<Result<User, UpdateUserError>>
        +Handle(DeactivateUserCommand, CancellationToken) : Task<Result<User, UpdateUserError>>
      }
    }

    package "Internal.QueryServices" {
      class UserQueryService <<service>> {
        +Handle(GetAllUsersQuery, CancellationToken) : Task<IEnumerable<User>>
        +Handle(GetUserByIdQuery, CancellationToken) : Task<User?>
        +Handle(GetUserByUsernameQuery, CancellationToken) : Task<User?>
      }
    }

    package "ACL" {
      class IamContextFacade <<facade>> {
        +ExistsUserById(int, CancellationToken) : Task<bool>
        +FetchUsernameById(int, CancellationToken) : Task<string?>
      }
    }
  }

  package "Infrastructure" {
    package "Persistence.EFC.Repositories" {
      class UserRepository <<repository>> {
        +FindByUsernameAsync(Username, CancellationToken) : Task<User?>
        +ExistsByUsernameAsync(Username, CancellationToken) : Task<bool>
      }
    }

    package "Hashing.BCrypt" {
      class BCryptHashingService <<service>> {
        +HashPassword(string) : string
        +VerifyPassword(string, string) : bool
      }
    }

    package "Tokens.JWT" {
      class JwtTokenService <<service>> {
        +GenerateToken(User) : string
        +ValidateToken(string) : Task<int?>
      }
    }

    package "Pipeline.Middleware" {
      class RequestAuthorizationMiddleware <<middleware>> {
        +InvokeAsync(HttpContext, IUserQueryService, ITokenService) : Task
      }

      class AuthorizeAttribute <<attribute>> {
        +Role[] Roles
        +OnAuthorization(AuthorizationFilterContext) : void
      }
    }
  }
}

package "Shared" {
  abstract class "Result<TValue, TError>" as ResultT <<result>>
  interface IBaseRepository<TEntity> <<repository>>
  interface IUnitOfWork <<unit-of-work>>
  class BaseRepository<TEntity> <<repository>>
  interface IAuditableEntity <<auditable>>
}

' Relationships
AuthenticationController --> IUserCommandService : uses
AuthenticationController --> SignInCommandFromResourceAssembler : uses
AuthenticationController --> SignUpCommandFromResourceAssembler : uses
AuthenticationController --> AuthenticatedUserResourceFromEntityAssembler : uses
UsersController --> IUserCommandService : uses
UsersController --> IUserQueryService : uses
UsersController --> UserResourceFromEntityAssembler : uses

SignInCommandFromResourceAssembler ..> SignInResource : reads
SignInCommandFromResourceAssembler --> SignInCommand : produces
SignUpCommandFromResourceAssembler ..> SignUpResource : reads
SignUpCommandFromResourceAssembler --> SignUpCommand : produces
AuthenticatedUserResourceFromEntityAssembler ..> AuthenticatedUser : reads
AuthenticatedUser --> User : wraps
AuthenticatedUserResourceFromEntityAssembler --> AuthenticatedUserResource : produces
UserResourceFromEntityAssembler ..> User : reads
UserResourceFromEntityAssembler --> UserResource : produces

UserCommandService ..|> IUserCommandService : implements
UserQueryService ..|> IUserQueryService : implements
IamContextFacade ..|> IIamContextFacade : implements
IamContextFacade --> IUserQueryService : uses

UserCommandService --> IUserRepository : uses
UserCommandService --> IUnitOfWork : uses
UserCommandService --> IHashingService : uses
UserCommandService --> ITokenService : uses
UserCommandService ..> ResultT : returns
UserQueryService --> IUserRepository : uses

IUserRepository --|> IBaseRepository : extends
UserRepository ..|> IUserRepository : implements
UserRepository --|> BaseRepository : extends
BCryptHashingService ..|> IHashingService : implements
JwtTokenService ..|> ITokenService : implements
RequestAuthorizationMiddleware ..> ITokenService : uses
RequestAuthorizationMiddleware ..> IUserQueryService : uses

User ..|> IAuditableEntity : implements
User --> Username : owns
User --> Role : has
SignUpCommand --> Username : contains
SignUpCommand --> Role : contains
SignInCommand --> Username : contains
ChangeUserRoleCommand --> Role : contains

note right of User
  Roles:
  - Admin: gestiona usuarios y parámetros
  - Management: ve todos los reportes
  - Accounting: facturación, gastos, tesorería
  - Engineer: proyectos, avance y gastos
  Username único.
end note
@enduml
