@startuml
' Brasper Platform - Treasury Bounded Context (Java 21 / Spring Boot 3)

skinparam classAttributeIconSize 0
set separator none
hide empty members

package "treasury" {

  package "interfaces.rest" {
    class BankAccountsController <<rest-controller>> {
      +openBankAccount(OpenBankAccountResource) : ResponseEntity<?>
      +getAllBankAccounts() : ResponseEntity<?>
      +getBankAccountById(Long) : ResponseEntity<?>
      +getMovements(Long, int, int) : ResponseEntity<?>
      +registerAdjustment(Long, RegisterAdjustmentResource) : ResponseEntity<?>
      +transferFunds(TransferFundsResource) : ResponseEntity<?>
    }

    class PayablesController <<rest-controller>> {
      +createPayable(CreatePayableResource) : ResponseEntity<?>
      +registerPayment(Long, RegisterPayablePaymentResource) : ResponseEntity<?>
      +reschedulePayable(Long, ReschedulePayableResource) : ResponseEntity<?>
      +getPayableById(Long) : ResponseEntity<?>
      +getPayablesWithParameters(String, Integer, Integer) : ResponseEntity<?>
    }

    class LoansController <<rest-controller>> {
      +registerLoan(RegisterLoanResource) : ResponseEntity<?>
      +scheduleInstallment(Long, ScheduleInstallmentResource) : ResponseEntity<?>
      +payInstallment(Long, Long, PayInstallmentResource) : ResponseEntity<?>
      +getLoanById(Long) : ResponseEntity<?>
      +getLoansWithParameters(String) : ResponseEntity<?>
    }

    class PartnersController <<rest-controller>> {
      +registerPartner(RegisterPartnerResource) : ResponseEntity<?>
      +registerContribution(Long, RegisterContributionResource) : ResponseEntity<?>
      +getAllPartners() : ResponseEntity<?>
      +getContributionsByPeriod(int, int) : ResponseEntity<?>
    }
  }

  package "interfaces.rest.resources" {
    class OpenBankAccountResource <<request-resource>> {
      +String bank
      +String accountNumber
      +String type
      +String currency
      +BigDecimal openingBalance
      +LocalDate openedOn
    }

    class BankAccountResource <<response-resource>> {
      +Long id
      +String bank
      +String accountNumber
      +String type
      +String currency
      +BigDecimal openingBalance
      +BigDecimal currentBalance
    }

    class RegisterAdjustmentResource <<request-resource>> {
      +LocalDate occurredOn
      +String direction
      +BigDecimal amount
      +String concept
    }

    class TransferFundsResource <<request-resource>> {
      +Long fromAccountId
      +Long toAccountId
      +LocalDate transferredOn
      +BigDecimal amount
      +String concept
    }

    class CashMovementResource <<response-resource>> {
      +Long id
      +LocalDate occurredOn
      +String direction
      +BigDecimal amount
      +String concept
      +String source
      +Long sourceId
    }

    class CreatePayableResource <<request-resource>> {
      +String concept
      +String type
      +BigDecimal totalAmount
      +String currency
      +Long supplierId
      +Long projectId
      +LocalDate expectedOn
    }

    class RegisterPayablePaymentResource <<request-resource>> {
      +LocalDate paidOn
      +BigDecimal amount
      +Long bankAccountId
    }

    class ReschedulePayableResource <<request-resource>> {
      +LocalDate expectedOn
    }

    class PayableResource <<response-resource>> {
      +Long id
      +String concept
      +String type
      +BigDecimal totalAmount
      +BigDecimal paidAmount
      +BigDecimal balance
      +Long supplierId
      +Long projectId
      +Long expenseId
      +Integer year
      +Integer month
      +Integer week
      +String status
    }

    class RegisterLoanResource <<request-resource>> {
      +String type
      +String counterparty
      +BigDecimal principal
      +String currency
      +BigDecimal interestRate
      +LocalDate disbursedOn
      +Long bankAccountId
    }

    class ScheduleInstallmentResource <<request-resource>> {
      +LocalDate dueOn
      +BigDecimal principal
      +BigDecimal interest
    }

    class PayInstallmentResource <<request-resource>> {
      +LocalDate paidOn
      +Long bankAccountId
    }

    class LoanResource <<response-resource>> {
      +Long id
      +String type
      +String counterparty
      +BigDecimal principal
      +BigDecimal interestRate
      +LocalDate disbursedOn
      +BigDecimal totalInterest
      +BigDecimal outstandingBalance
      +String status
    }

    class RegisterPartnerResource <<request-resource>> {
      +String fullName
      +String role
    }

    class RegisterContributionResource <<request-resource>> {
      +LocalDate contributedOn
      +BigDecimal amount
      +boolean reimbursable
      +Long bankAccountId
      +String concept
    }

    class PartnerResource <<response-resource>> {
      +Long id
      +String fullName
      +String role
      +BigDecimal totalContributed
    }
  }

  package "interfaces.rest.transform" {
    class OpenBankAccountCommandFromResourceAssembler <<translator>> {
      +toCommandFromResource(OpenBankAccountResource) : OpenBankAccountCommand
    }

    class TransferFundsCommandFromResourceAssembler <<translator>> {
      +toCommandFromResource(TransferFundsResource) : TransferFundsCommand
    }

    class CreatePayableCommandFromResourceAssembler <<translator>> {
      +toCommandFromResource(CreatePayableResource) : CreatePayableCommand
    }

    class RegisterPayablePaymentCommandFromResourceAssembler <<translator>> {
      +toCommandFromResource(Long, RegisterPayablePaymentResource) : RegisterPayablePaymentCommand
    }

    class RegisterLoanCommandFromResourceAssembler <<translator>> {
      +toCommandFromResource(RegisterLoanResource) : RegisterLoanCommand
    }

    class RegisterContributionCommandFromResourceAssembler <<translator>> {
      +toCommandFromResource(Long, RegisterContributionResource) : RegisterPartnerContributionCommand
    }

    class TreasuryValueObjectFromStringAssembler <<translator>> {
      +toBankFromString(String) : Bank
      +toAccountTypeFromString(String) : AccountType
      +toAccountNumberFromString(String) : AccountNumber
      +toPayableTypeFromString(String) : PayableType
      +toLoanTypeFromString(String) : LoanType
    }

    class BankAccountResourceFromEntityAssembler <<translator>> {
      +toResourceFromEntity(BankAccount) : BankAccountResource
    }

    class CashMovementResourceFromEntityAssembler <<translator>> {
      +toResourceFromEntity(CashMovement) : CashMovementResource
    }

    class PayableResourceFromEntityAssembler <<translator>> {
      +toResourceFromEntity(Payable) : PayableResource
    }

    class LoanResourceFromEntityAssembler <<translator>> {
      +toResourceFromEntity(Loan) : LoanResource
    }

    class PartnerResourceFromEntityAssembler <<translator>> {
      +toResourceFromEntity(Partner) : PartnerResource
    }

    class ResponseEntityFromTreasuryCommandResultAssembler <<translator>> {
      +toResponseEntityFromBankAccountResult(Result<BankAccount, BankAccountCommandFailure>, MessageSource) : ResponseEntity<?>
      +toResponseEntityFromPayableResult(Result<Payable, PayableCommandFailure>, MessageSource) : ResponseEntity<?>
      +toResponseEntityFromLoanResult(Result<Loan, LoanCommandFailure>, MessageSource) : ResponseEntity<?>
      +toResponseEntityFromPartnerResult(Result<Partner, PartnerCommandFailure>, MessageSource) : ResponseEntity<?>
    }

    class ResponseEntityFromTreasuryQueryResultAssembler <<translator>> {
      +toResponseEntityFromBankAccount(BankAccount) : ResponseEntity<?>
      +toResponseEntityFromBankAccountList(List<BankAccount>) : ResponseEntity<?>
      +toResponseEntityFromMovementList(List<CashMovement>) : ResponseEntity<?>
      +toResponseEntityFromPayable(Payable) : ResponseEntity<?>
      +toResponseEntityFromPayableList(List<Payable>) : ResponseEntity<?>
      +toResponseEntityFromLoan(Loan) : ResponseEntity<?>
      +toResponseEntityFromLoanList(List<Loan>) : ResponseEntity<?>
      +toResponseEntityFromPartnerList(List<Partner>) : ResponseEntity<?>
      +notFound(MessageSource, String, Object...) : ResponseEntity<ProblemDetail>
    }
  }

  package "interfaces.acl" {
    interface TreasuryContextFacade <<context-facade>> {
      +existsBankAccountById(Long) : boolean
      +fetchBankAccountType(Long) : Optional<String>
      +existsPartnerById(Long) : boolean
      +fetchCashBalanceAt(LocalDate) : BigDecimal
      +fetchCashBalanceByAccountAt(LocalDate) : Map<String, BigDecimal>
      +sumInflowsByWeek(int, int, int) : Map<String, BigDecimal>
      +sumOutflowsByWeek(int, int, int) : Map<String, BigDecimal>
      +sumScheduledPayablesByWeek(int, int, int) : BigDecimal
      +sumScheduledInstallmentsByWeek(int, int, int) : BigDecimal
    }
  }

  package "application.commandservices" {
    interface BankAccountCommandService <<application-service>> {
      +handle(OpenBankAccountCommand) : Result<BankAccount, BankAccountCommandFailure>
      +handle(RegisterCashMovementCommand) : Result<BankAccount, BankAccountCommandFailure>
      +handle(TransferFundsCommand) : Result<BankAccount, BankAccountCommandFailure>
    }

    interface PayableCommandService <<application-service>> {
      +handle(CreatePayableCommand) : Result<Payable, PayableCommandFailure>
      +handle(RegisterPayablePaymentCommand) : Result<Payable, PayableCommandFailure>
      +handle(ReschedulePayableCommand) : Result<Payable, PayableCommandFailure>
    }

    interface LoanCommandService <<application-service>> {
      +handle(RegisterLoanCommand) : Result<Loan, LoanCommandFailure>
      +handle(ScheduleLoanInstallmentCommand) : Result<Loan, LoanCommandFailure>
      +handle(PayLoanInstallmentCommand) : Result<Loan, LoanCommandFailure>
    }

    interface PartnerCommandService <<application-service>> {
      +handle(RegisterPartnerCommand) : Result<Partner, PartnerCommandFailure>
      +handle(RegisterPartnerContributionCommand) : Result<Partner, PartnerCommandFailure>
    }

    interface BankAccountCommandFailure <<failure>> {
      +messageKey() : String
    }

    class "BankAccountCommandFailure.DuplicateAccountNumber" as BankFailureDuplicateNumber <<failure>>
    class "BankAccountCommandFailure.NotFound" as BankFailureNotFound <<failure>>
    class "BankAccountCommandFailure.SameAccount" as BankFailureSameAccount <<failure>>
    class "BankAccountCommandFailure.CurrencyMismatch" as BankFailureCurrencyMismatch <<failure>>

    interface PayableCommandFailure <<failure>> {
      +messageKey() : String
    }

    class "PayableCommandFailure.NotFound" as PayableFailureNotFound <<failure>>
    class "PayableCommandFailure.AlreadyPaid" as PayableFailureAlreadyPaid <<failure>>
    class "PayableCommandFailure.AmountExceedsBalance" as PayableFailureAmountExceedsBalance <<failure>>
    class "PayableCommandFailure.BankAccountNotFound" as PayableFailureBankAccountNotFound <<failure>>

    interface LoanCommandFailure <<failure>> {
      +messageKey() : String
    }

    class "LoanCommandFailure.NotFound" as LoanFailureNotFound <<failure>>
    class "LoanCommandFailure.InstallmentNotFound" as LoanFailureInstallmentNotFound <<failure>>
    class "LoanCommandFailure.InstallmentAlreadyPaid" as LoanFailureInstallmentAlreadyPaid <<failure>>
    class "LoanCommandFailure.InstallmentsExceedPrincipal" as LoanFailureInstallmentsExceedPrincipal <<failure>>
    class "LoanCommandFailure.BankAccountNotFound" as LoanFailureBankAccountNotFound <<failure>>

    interface PartnerCommandFailure <<failure>> {
      +messageKey() : String
    }

    class "PartnerCommandFailure.NotFound" as PartnerFailureNotFound <<failure>>
    class "PartnerCommandFailure.Duplicate" as PartnerFailureDuplicate <<failure>>
    class "PartnerCommandFailure.InvalidAmount" as PartnerFailureInvalidAmount <<failure>>
  }

  package "application.queryservices" {
    interface BankAccountQueryService <<application-service>> {
      +handle(GetAllBankAccountsQuery) : List<BankAccount>
      +handle(GetBankAccountByIdQuery) : Optional<BankAccount>
      +handle(GetCashMovementsByAccountAndPeriodQuery) : List<CashMovement>
    }

    interface PayableQueryService <<application-service>> {
      +handle(GetAllPayablesQuery) : List<Payable>
      +handle(GetPayableByIdQuery) : Optional<Payable>
    }

    interface LoanQueryService <<application-service>> {
      +handle(GetAllLoansQuery) : List<Loan>
      +handle(GetLoanByIdQuery) : Optional<Loan>
    }

    interface PartnerQueryService <<application-service>> {
      +handle(GetAllPartnersQuery) : List<Partner>
      +handle(GetContributionsByPeriodQuery) : List<PartnerContribution>
    }
  }

  package "application.internal.commandservices" {
    class BankAccountCommandServiceImpl <<application-service>> {
      +handle(OpenBankAccountCommand) : Result<BankAccount, BankAccountCommandFailure>
      +handle(RegisterCashMovementCommand) : Result<BankAccount, BankAccountCommandFailure>
      +handle(TransferFundsCommand) : Result<BankAccount, BankAccountCommandFailure>
    }

    class PayableCommandServiceImpl <<application-service>> {
      +handle(CreatePayableCommand) : Result<Payable, PayableCommandFailure>
      +handle(RegisterPayablePaymentCommand) : Result<Payable, PayableCommandFailure>
      +handle(ReschedulePayableCommand) : Result<Payable, PayableCommandFailure>
    }

    class LoanCommandServiceImpl <<application-service>> {
      +handle(RegisterLoanCommand) : Result<Loan, LoanCommandFailure>
      +handle(ScheduleLoanInstallmentCommand) : Result<Loan, LoanCommandFailure>
      +handle(PayLoanInstallmentCommand) : Result<Loan, LoanCommandFailure>
    }

    class PartnerCommandServiceImpl <<application-service>> {
      +handle(RegisterPartnerCommand) : Result<Partner, PartnerCommandFailure>
      +handle(RegisterPartnerContributionCommand) : Result<Partner, PartnerCommandFailure>
    }
  }

  package "application.internal.queryservices" {
    class BankAccountQueryServiceImpl <<application-service>> {
      +handle(GetAllBankAccountsQuery) : List<BankAccount>
      +handle(GetBankAccountByIdQuery) : Optional<BankAccount>
      +handle(GetCashMovementsByAccountAndPeriodQuery) : List<CashMovement>
    }

    class PayableQueryServiceImpl <<application-service>> {
      +handle(GetAllPayablesQuery) : List<Payable>
      +handle(GetPayableByIdQuery) : Optional<Payable>
    }

    class LoanQueryServiceImpl <<application-service>> {
      +handle(GetAllLoansQuery) : List<Loan>
      +handle(GetLoanByIdQuery) : Optional<Loan>
    }

    class PartnerQueryServiceImpl <<application-service>> {
      +handle(GetAllPartnersQuery) : List<Partner>
      +handle(GetContributionsByPeriodQuery) : List<PartnerContribution>
    }
  }

  package "application.internal.eventhandlers" {
    class InvoicePaymentReceivedEventHandler <<event-handler>> {
      +on(InvoicePaymentReceivedEvent) : void
    }

    class InvoiceIssuedEventHandler <<event-handler>> {
      +on(InvoiceIssuedEvent) : void
    }

    class ExpenseRegisteredEventHandler <<event-handler>> {
      +on(ExpenseRegisteredEvent) : void
    }

    class FixedCostPaidEventHandler <<event-handler>> {
      +on(FixedCostPaidEvent) : void
    }

    class TaxReturnPaidEventHandler <<event-handler>> {
      +on(TaxReturnPaidEvent) : void
    }
  }

  package "application.acl" {
    class TreasuryContextFacadeImpl <<context-facade>> {
      +existsBankAccountById(Long) : boolean
      +fetchBankAccountType(Long) : Optional<String>
      +existsPartnerById(Long) : boolean
      +fetchCashBalanceAt(LocalDate) : BigDecimal
      +fetchCashBalanceByAccountAt(LocalDate) : Map<String, BigDecimal>
      +sumInflowsByWeek(int, int, int) : Map<String, BigDecimal>
      +sumOutflowsByWeek(int, int, int) : Map<String, BigDecimal>
      +sumScheduledPayablesByWeek(int, int, int) : BigDecimal
      +sumScheduledInstallmentsByWeek(int, int, int) : BigDecimal
    }
  }

  package "domain.model.aggregates" {
    class BankAccount <<aggregate-root>> {
      +ACCOUNT_NUMBER_UNIQUE_CONSTRAINT : String
      -Long id
      -Bank bank
      -AccountNumber accountNumber
      -AccountType type
      -Currency currency
      -Money openingBalance
      -LocalDate openedOn
      -List<CashMovement> movements
      -Instant createdAt
      -Instant updatedAt
      +BankAccount(OpenBankAccountCommand)
      +registerInflow(LocalDate, Money, String, MovementSource, Long) : CashMovement
      +registerOutflow(LocalDate, Money, String, MovementSource, Long) : CashMovement
      +balanceAt(LocalDate) : Money
      +inflowsBetween(LocalDate, LocalDate) : Money
      +outflowsBetween(LocalDate, LocalDate) : Money
    }

    class Payable <<aggregate-root>> {
      -Long id
      -String concept
      -PayableType type
      -Money totalAmount
      -Long supplierId
      -Long projectId
      -Long expenseId
      -CashFlowWeek scheduledWeek
      -PaymentStatus status
      -List<PayablePayment> payments
      -Instant createdAt
      -Instant updatedAt
      +Payable(CreatePayableCommand)
      +registerPayment(LocalDate, Money, Long) : PayablePayment
      +reschedule(CashFlowWeek) : void
      +paidAmount() : Money
      +balance() : Money
    }

    class Loan <<aggregate-root>> {
      -Long id
      -LoanType type
      -String counterparty
      -Money principal
      -Percentage interestRate
      -LocalDate disbursedOn
      -Long bankAccountId
      -PaymentStatus status
      -List<LoanInstallment> installments
      -Instant createdAt
      -Instant updatedAt
      +Loan(RegisterLoanCommand)
      +scheduleInstallment(LocalDate, Money, Money) : LoanInstallment
      +payInstallment(Long, LocalDate) : LoanInstallment
      +totalInterest() : Money
      +outstandingBalance() : Money
    }

    class Partner <<aggregate-root>> {
      -Long id
      -String fullName
      -String role
      -List<PartnerContribution> contributions
      -Instant createdAt
      -Instant updatedAt
      +Partner(RegisterPartnerCommand)
      +registerContribution(RegisterPartnerContributionCommand) : PartnerContribution
      +totalContributed() : Money
      +contributedIn(Period) : Money
    }
  }

  package "domain.model.entities" {
    class CashMovement <<entity>> {
      -Long id
      -BankAccount bankAccount
      -LocalDate occurredOn
      -MovementDirection direction
      -Money amount
      -String concept
      -MovementSource source
      -Long sourceId
    }

    class PayablePayment <<entity>> {
      -Long id
      -Payable payable
      -LocalDate paidOn
      -Money amount
      -Long bankAccountId
    }

    class LoanInstallment <<entity>> {
      -Long id
      -Loan loan
      -LocalDate dueOn
      -CashFlowWeek dueWeek
      -Money principal
      -Money interest
      -boolean paid
      -LocalDate paidOn
      +total() : Money
    }

    class PartnerContribution <<entity>> {
      -Long id
      -Partner partner
      -LocalDate contributedOn
      -Money amount
      -boolean reimbursable
      -Long bankAccountId
      -Long expenseId
      -String concept
    }
  }

  package "domain.model.valueobjects" {
    enum Bank <<value-object>> {
      BCP
      BBVA
      BANCO_DE_LA_NACION
      CASH
    }

    enum AccountType <<value-object>> {
      CHECKING
      DETRACTIONS
      PETTY_CASH
    }

    class AccountNumber <<value-object>> {
      +String value
    }

    enum MovementDirection <<value-object>> {
      INFLOW
      OUTFLOW
    }

    enum MovementSource <<value-object>> {
      OPENING_BALANCE
      INVOICE_PAYMENT
      EXPENSE
      FIXED_COST_PAYMENT
      PAYABLE_PAYMENT
      LOAN_DISBURSEMENT
      LOAN_INSTALLMENT
      PARTNER_CONTRIBUTION
      TAX_PAYMENT
      TRANSFER
      ADJUSTMENT
    }

    enum PayableType <<value-object>> {
      SUPPLIER
      TECHNICIAN
      ACCOUNTING
      SELF_DETRACTION
      TAX
      OTHER
    }

    enum LoanType <<value-object>> {
      RECEIVED
      GRANTED
    }
  }

  package "domain.model.commands" {
    class OpenBankAccountCommand <<command>> {
      +Bank bank
      +AccountNumber accountNumber
      +AccountType type
      +Currency currency
      +Money openingBalance
      +LocalDate openedOn
    }

    class RegisterCashMovementCommand <<command>> {
      +Long bankAccountId
      +LocalDate occurredOn
      +MovementDirection direction
      +Money amount
      +String concept
      +MovementSource source
      +Long sourceId
    }

    class TransferFundsCommand <<command>> {
      +Long fromAccountId
      +Long toAccountId
      +LocalDate transferredOn
      +Money amount
      +String concept
    }

    class CreatePayableCommand <<command>> {
      +String concept
      +PayableType type
      +Money totalAmount
      +Long supplierId
      +Long projectId
      +Long expenseId
      +CashFlowWeek scheduledWeek
    }

    class RegisterPayablePaymentCommand <<command>> {
      +Long payableId
      +LocalDate paidOn
      +Money amount
      +Long bankAccountId
    }

    class ReschedulePayableCommand <<command>> {
      +Long payableId
      +CashFlowWeek scheduledWeek
    }

    class RegisterLoanCommand <<command>> {
      +LoanType type
      +String counterparty
      +Money principal
      +Percentage interestRate
      +LocalDate disbursedOn
      +Long bankAccountId
    }

    class ScheduleLoanInstallmentCommand <<command>> {
      +Long loanId
      +LocalDate dueOn
      +Money principal
      +Money interest
    }

    class PayLoanInstallmentCommand <<command>> {
      +Long loanId
      +Long installmentId
      +LocalDate paidOn
      +Long bankAccountId
    }

    class RegisterPartnerCommand <<command>> {
      +String fullName
      +String role
    }

    class RegisterPartnerContributionCommand <<command>> {
      +Long partnerId
      +LocalDate contributedOn
      +Money amount
      +boolean reimbursable
      +Long bankAccountId
      +Long expenseId
      +String concept
    }
  }

  package "domain.model.queries" {
    class GetAllBankAccountsQuery <<query>>

    class GetBankAccountByIdQuery <<query>> {
      +Long id
    }

    class GetCashMovementsByAccountAndPeriodQuery <<query>> {
      +Long bankAccountId
      +Period period
    }

    class GetAllPayablesQuery <<query>> {
      +PaymentStatus status
      +Period scheduledIn
    }

    class GetPayableByIdQuery <<query>> {
      +Long id
    }

    class GetAllLoansQuery <<query>> {
      +LoanType type
    }

    class GetLoanByIdQuery <<query>> {
      +Long id
    }

    class GetAllPartnersQuery <<query>>

    class GetContributionsByPeriodQuery <<query>> {
      +Period period
    }
  }

  package "domain.model.events" {
    class PayablePaidEvent <<domain-event>> {
      +Long payableId
      +Long paymentId
      +PayableType type
      +Long expenseId
      +LocalDate paidOn
      +Money amount
      +boolean fullyPaid
    }

    class LoanDisbursedEvent <<domain-event>> {
      +Long loanId
      +LoanType type
      +LocalDate disbursedOn
      +Money principal
    }

    class LoanInstallmentPaidEvent <<domain-event>> {
      +Long loanId
      +Long installmentId
      +LoanType type
      +LocalDate paidOn
      +Money principal
      +Money interest
    }

    class PartnerContributionRegisteredEvent <<domain-event>> {
      +Long partnerId
      +Long contributionId
      +LocalDate contributedOn
      +Money amount
      +boolean reimbursable
      +Long expenseId
    }

    class FundsTransferredEvent <<domain-event>> {
      +Long fromAccountId
      +Long toAccountId
      +LocalDate transferredOn
      +Money amount
    }
  }

  package "domain.services" {
    class FundsTransferDomainService <<domain-service>> {
      +transfer(BankAccount, BankAccount, LocalDate, Money, String) : void
    }
  }

  package "infrastructure.persistence.jpa" {
    interface BankAccountRepository <<spring-data-repository>> {
      +findByAccountNumber(AccountNumber) : Optional<BankAccount>
      +existsByAccountNumber(AccountNumber) : boolean
      +findAllByType(AccountType) : List<BankAccount>
    }

    interface CashMovementRepository <<spring-data-repository>> {
      +findAllByBankAccountIdAndOccurredOnBetween(Long, LocalDate, LocalDate) : List<CashMovement>
      +existsBySourceAndSourceIdAndBankAccountId(MovementSource, Long, Long) : boolean
    }

    interface PayableRepository <<spring-data-repository>> {
      +findAllByStatus(PaymentStatus) : List<Payable>
      +findAllByScheduledWeek(CashFlowWeek) : List<Payable>
      +findByExpenseId(Long) : Optional<Payable>
    }

    interface LoanRepository <<spring-data-repository>> {
      +findAllByType(LoanType) : List<Loan>
      +findAllByInstallmentsDueWeek(CashFlowWeek) : List<Loan>
    }

    interface PartnerRepository <<spring-data-repository>> {
      +existsByFullName(String) : boolean
    }

    class AccountNumberAttributeConverter <<jpa-converter>> {
      +convertToDatabaseColumn(AccountNumber) : String
      +convertToEntityAttribute(String) : AccountNumber
    }
  }
}

package "shared" {
  interface "Result<T, E>" as Result <<sealed-result>>
  interface CommandFailure <<failure>>
  class Money <<embeddable-value-object>>
  class Percentage <<value-object>>
  class Period <<embeddable-value-object>>
  class CashFlowWeek <<embeddable-value-object>>
  enum Currency <<value-object>>
  enum PaymentStatus <<value-object>>
}

package "other bounded contexts" {
  class InvoiceIssuedEvent <<domain-event>>
  class InvoicePaymentReceivedEvent <<domain-event>>
  class ExpenseRegisteredEvent <<domain-event>>
  class FixedCostPaidEvent <<domain-event>>
  class TaxReturnPaidEvent <<domain-event>>
}

package "org.springframework" {
  interface "JpaRepository<T, ID>" as JpaRepository <<Spring Data>>
  abstract class "AbstractAggregateRoot<A>" as AbstractAggregateRoot <<Spring Data>>
}

' Interfaces
BankAccountsController --> BankAccountCommandService : invokes
BankAccountsController --> BankAccountQueryService : invokes
BankAccountsController ..> OpenBankAccountResource : accepts
BankAccountsController --> OpenBankAccountCommandFromResourceAssembler : uses
BankAccountsController --> TransferFundsCommandFromResourceAssembler : uses
BankAccountsController --> ResponseEntityFromTreasuryCommandResultAssembler : uses
BankAccountsController --> ResponseEntityFromTreasuryQueryResultAssembler : uses
PayablesController --> PayableCommandService : invokes
PayablesController --> PayableQueryService : invokes
PayablesController ..> CreatePayableResource : accepts
PayablesController --> CreatePayableCommandFromResourceAssembler : uses
PayablesController --> RegisterPayablePaymentCommandFromResourceAssembler : uses
PayablesController --> ResponseEntityFromTreasuryCommandResultAssembler : uses
PayablesController --> ResponseEntityFromTreasuryQueryResultAssembler : uses
LoansController --> LoanCommandService : invokes
LoansController --> LoanQueryService : invokes
LoansController ..> RegisterLoanResource : accepts
LoansController --> RegisterLoanCommandFromResourceAssembler : uses
LoansController --> ResponseEntityFromTreasuryCommandResultAssembler : uses
LoansController --> ResponseEntityFromTreasuryQueryResultAssembler : uses
PartnersController --> PartnerCommandService : invokes
PartnersController --> PartnerQueryService : invokes
PartnersController ..> RegisterContributionResource : accepts
PartnersController --> RegisterContributionCommandFromResourceAssembler : uses
PartnersController --> ResponseEntityFromTreasuryCommandResultAssembler : uses
PartnersController --> ResponseEntityFromTreasuryQueryResultAssembler : uses

' HTTP mapping
