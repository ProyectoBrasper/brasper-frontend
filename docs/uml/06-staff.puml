@startuml
' Brasper Platform - Staff Bounded Context (Personal y Costos Fijos)

skinparam classAttributeIconSize 0
set separator none

package "Staff" {

  package "Interfaces.REST" {
    class EmployeesController {
      +HireEmployee(HireEmployeeResource, CancellationToken) : Task<ActionResult>
      +UpdateEmployee(int, UpdateEmployeeResource, CancellationToken) : Task<ActionResult>
      +TerminateEmployee(int, CancellationToken) : Task<ActionResult>
      +GetAllEmployees(bool?, CancellationToken) : Task<ActionResult>
      +GetEmployeeById(int, CancellationToken) : Task<ActionResult>
    }

    class FixedCostsController {
      +CreateFixedCost(CreateFixedCostResource, CancellationToken) : Task<ActionResult>
      +UpdateFixedCost(int, UpdateFixedCostResource, CancellationToken) : Task<ActionResult>
      +DeactivateFixedCost(int, CancellationToken) : Task<ActionResult>
      +GetAllFixedCosts(bool?, CancellationToken) : Task<ActionResult>
      +GetFixedCostById(int, CancellationToken) : Task<ActionResult>
    }

    class FixedCostPaymentsController {
      +RegisterPayment(int, RegisterFixedCostPaymentResource, CancellationToken) : Task<ActionResult>
      +GetPaymentsByPeriod(int, int, CancellationToken) : Task<ActionResult>
    }

    package "Resources" {
      class EmployeeResource <<resource>> {
        +int Id
        +string FullName
        +string Dni
        +string Position
        +decimal MonthlySalary
        +DateOnly HiredOn
        +DateOnly? TerminatedOn
        +bool IsActive
      }

      class HireEmployeeResource <<resource>> {
        +string FullName
        +string Dni
        +string Position
        +decimal MonthlySalary
        +DateOnly HiredOn
      }

      class UpdateEmployeeResource <<resource>> {
        +string Position
        +decimal MonthlySalary
      }

      class FixedCostResource <<resource>> {
        +int Id
        +string Code
        +string Concept
        +string Type
        +decimal MonthlyAmount
        +int? EmployeeId
        +bool IsActive
      }

      class CreateFixedCostResource <<resource>> {
        +string Code
        +string Concept
        +string Type
        +decimal MonthlyAmount
        +int? EmployeeId
      }

      class UpdateFixedCostResource <<resource>> {
        +string Concept
        +decimal MonthlyAmount
      }

      class FixedCostPaymentResource <<resource>> {
        +int Id
        +int FixedCostId
        +DateOnly PaidOn
        +int Year
        +int Month
        +decimal Amount
        +int BankAccountId
        +string? Notes
      }

      class RegisterFixedCostPaymentResource <<resource>> {
        +DateOnly PaidOn
        +int Year
        +int Month
        +decimal Amount
        +int BankAccountId
        +string? Notes
      }
    }

    package "Transform" {
      class EmployeeResourceFromEntityAssembler <<assembler>> {
        +ToResourceFromEntity(Employee) : EmployeeResource
      }

      class HireEmployeeCommandFromResourceAssembler <<assembler>> {
        +ToCommandFromResource(HireEmployeeResource) : HireEmployeeCommand
      }

      class FixedCostResourceFromEntityAssembler <<assembler>> {
        +ToResourceFromEntity(FixedCost) : FixedCostResource
      }

      class CreateFixedCostCommandFromResourceAssembler <<assembler>> {
        +ToCommandFromResource(CreateFixedCostResource) : CreateFixedCostCommand
      }

      class FixedCostPaymentResourceFromEntityAssembler <<assembler>> {
        +ToResourceFromEntity(FixedCostPayment) : FixedCostPaymentResource
      }

      class RegisterFixedCostPaymentCommandFromResourceAssembler <<assembler>> {
        +ToCommandFromResource(int, RegisterFixedCostPaymentResource) : RegisterFixedCostPaymentCommand
      }
    }
  }

  package "Interfaces.ACL" {
    interface IStaffContextFacade <<facade>> {
      +SumFixedCostsAccruedByPeriod(Period, CancellationToken) : Task<decimal>
      +FetchFixedCostsPaidByWeek(CashFlowWeek, CancellationToken) : Task<IDictionary<string, decimal>>
      +FetchFixedCostsScheduledByWeek(CashFlowWeek, CancellationToken) : Task<IDictionary<string, decimal>>
    }
  }

  package "Domain.Model" {
    package "ValueObjects" {
      class Dni <<value-object>> {
        +string Value
        +Dni(string)
      }

      class CostCode <<value-object>> {
        +string Value
        +CostCode(string)
      }

      enum FixedCostType <<value-object>> {
        Salary
        Overtime
        Accounting
        SctrInsurance
        LifeInsurance
        OfficeRent
        Cleaning
        BankFees
        Itf
        Hosting
        Administrative
      }

      class PaymentSchedule <<value-object>> {
        +int DayOfMonth
        +bool SplitBiweekly
        +ExpectedWeeks(Period) : IReadOnlyList<CashFlowWeek>
      }
    }

    package "Commands" {
      class HireEmployeeCommand <<command>> {
        +string FullName
        +Dni Dni
        +string Position
        +Money MonthlySalary
        +DateOnly HiredOn
      }

      class UpdateEmployeeCommand <<command>> {
        +int EmployeeId
        +string Position
        +Money MonthlySalary
      }

      class TerminateEmployeeCommand <<command>> {
        +int EmployeeId
        +DateOnly TerminatedOn
      }

      class CreateFixedCostCommand <<command>> {
        +CostCode Code
        +string Concept
        +FixedCostType Type
        +Money MonthlyAmount
        +int? EmployeeId
        +PaymentSchedule Schedule
      }

      class UpdateFixedCostCommand <<command>> {
        +int FixedCostId
        +string Concept
        +Money MonthlyAmount
      }

      class DeactivateFixedCostCommand <<command>> {
        +int FixedCostId
      }

      class RegisterFixedCostPaymentCommand <<command>> {
        +int FixedCostId
        +DateOnly PaidOn
        +Period Period
        +Money Amount
        +int BankAccountId
        +string? Notes
      }
    }

    package "Queries" {
      class GetAllEmployeesQuery <<query>> {
        +bool? IsActive
      }

      class GetEmployeeByIdQuery <<query>> {
        +int Id
      }

      class GetAllFixedCostsQuery <<query>> {
        +bool? IsActive
      }

      class GetFixedCostByIdQuery <<query>> {
        +int Id
      }

      class GetFixedCostPaymentsByPeriodQuery <<query>> {
        +Period Period
      }
    }

    package "Events" {
      class FixedCostPaidEvent <<event>> {
        +int FixedCostId
        +int PaymentId
        +FixedCostType Type
        +Period Period
        +DateOnly PaidOn
        +Money Amount
        +int BankAccountId
      }
    }

    package "Aggregates" {
      class Employee <<aggregate>> {
        +int Id
        +string FullName
        +Dni Dni
        +string Position
        +Money MonthlySalary
        +DateOnly HiredOn
        +DateOnly? TerminatedOn
        +bool IsActive
        +Employee(HireEmployeeCommand)
        +Update(UpdateEmployeeCommand) : void
        +Terminate(DateOnly) : void
      }

      class FixedCost <<aggregate>> {
        +int Id
        +CostCode Code
        +string Concept
        +FixedCostType Type
        +Money MonthlyAmount
        +int? EmployeeId
        +PaymentSchedule Schedule
        +bool IsActive
        +IReadOnlyCollection<FixedCostPayment> Payments
        +FixedCost(CreateFixedCostCommand)
        +Update(UpdateFixedCostCommand) : void
        +Deactivate() : void
        +RegisterPayment(RegisterFixedCostPaymentCommand) : FixedCostPayment
        +PaidIn(Period) : Money
        +PendingIn(Period) : Money
      }
    }

    package "Entities" {
      class FixedCostPayment <<entity>> {
        +int Id
        +int FixedCostId
        +DateOnly PaidOn
        +Period Period
        +Money Amount
        +int BankAccountId
        +string? Notes
      }
    }
  }

  package "Domain.Repositories" {
    interface IEmployeeRepository <<repository>> {
      +FindByDniAsync(Dni, CancellationToken) : Task<Employee?>
      +FindActiveAsync(CancellationToken) : Task<IEnumerable<Employee>>
    }

    interface IFixedCostRepository <<repository>> {
      +FindByCodeAsync(CostCode, CancellationToken) : Task<FixedCost?>
      +FindActiveAsync(CancellationToken) : Task<IEnumerable<FixedCost>>
      +FindByEmployeeIdAsync(int, CancellationToken) : Task<IEnumerable<FixedCost>>
      +FindPaymentsByPeriodAsync(Period, CancellationToken) : Task<IEnumerable<FixedCostPayment>>
    }
  }

  package "Application" {
    package "Errors" {
      enum HireEmployeeError <<error>> {
        InvalidDni
        DuplicateDni
        InvalidSalary
        UnexpectedError
      }

      enum UpdateEmployeeError <<error>> {
        EmployeeNotFound
        EmployeeTerminated
        UnexpectedError
      }

      enum CreateFixedCostError <<error>> {
        DuplicateCostCode
        EmployeeNotFound
        EmployeeRequiredForSalary
        InvalidAmount
        UnexpectedError
      }

      enum UpdateFixedCostError <<error>> {
        FixedCostNotFound
        UnexpectedError
      }

      enum RegisterFixedCostPaymentError <<error>> {
        FixedCostNotFound
        FixedCostInactive
        BankAccountNotFound
        InvalidAmount
        UnexpectedError
      }
    }

    package "Services" {
      interface IEmployeeCommandService <<application-service>> {
        +Handle(HireEmployeeCommand, CancellationToken) : Task<Result<Employee, HireEmployeeError>>
        +Handle(UpdateEmployeeCommand, CancellationToken) : Task<Result<Employee, UpdateEmployeeError>>
        +Handle(TerminateEmployeeCommand, CancellationToken) : Task<Result<Employee, UpdateEmployeeError>>
      }

      interface IEmployeeQueryService <<application-service>> {
        +Handle(GetAllEmployeesQuery, CancellationToken) : Task<IEnumerable<Employee>>
        +Handle(GetEmployeeByIdQuery, CancellationToken) : Task<Employee?>
      }

      interface IFixedCostCommandService <<application-service>> {
        +Handle(CreateFixedCostCommand, CancellationToken) : Task<Result<FixedCost, CreateFixedCostError>>
        +Handle(UpdateFixedCostCommand, CancellationToken) : Task<Result<FixedCost, UpdateFixedCostError>>
        +Handle(DeactivateFixedCostCommand, CancellationToken) : Task<Result<FixedCost, UpdateFixedCostError>>
        +Handle(RegisterFixedCostPaymentCommand, CancellationToken) : Task<Result<FixedCostPayment, RegisterFixedCostPaymentError>>
      }

      interface IFixedCostQueryService <<application-service>> {
        +Handle(GetAllFixedCostsQuery, CancellationToken) : Task<IEnumerable<FixedCost>>
        +Handle(GetFixedCostByIdQuery, CancellationToken) : Task<FixedCost?>
        +Handle(GetFixedCostPaymentsByPeriodQuery, CancellationToken) : Task<IEnumerable<FixedCostPayment>>
      }
    }

    package "Internal.CommandServices" {
      class EmployeeCommandService <<service>> {
        +Handle(HireEmployeeCommand, CancellationToken) : Task<Result<Employee, HireEmployeeError>>
        +Handle(UpdateEmployeeCommand, CancellationToken) : Task<Result<Employee, UpdateEmployeeError>>
        +Handle(TerminateEmployeeCommand, CancellationToken) : Task<Result<Employee, UpdateEmployeeError>>
      }

      class FixedCostCommandService <<service>> {
        +Handle(CreateFixedCostCommand, CancellationToken) : Task<Result<FixedCost, CreateFixedCostError>>
        +Handle(UpdateFixedCostCommand, CancellationToken) : Task<Result<FixedCost, UpdateFixedCostError>>
        +Handle(DeactivateFixedCostCommand, CancellationToken) : Task<Result<FixedCost, UpdateFixedCostError>>
        +Handle(RegisterFixedCostPaymentCommand, CancellationToken) : Task<Result<FixedCostPayment, RegisterFixedCostPaymentError>>
      }
    }

    package "Internal.QueryServices" {
      class EmployeeQueryService <<service>> {
        +Handle(GetAllEmployeesQuery, CancellationToken) : Task<IEnumerable<Employee>>
        +Handle(GetEmployeeByIdQuery, CancellationToken) : Task<Employee?>
      }

      class FixedCostQueryService <<service>> {
        +Handle(GetAllFixedCostsQuery, CancellationToken) : Task<IEnumerable<FixedCost>>
        +Handle(GetFixedCostByIdQuery, CancellationToken) : Task<FixedCost?>
        +Handle(GetFixedCostPaymentsByPeriodQuery, CancellationToken) : Task<IEnumerable<FixedCostPayment>>
      }
    }

    package "Internal.OutboundServices.ACL" {
      class ExternalTreasuryService <<outbound-service>> {
        +ExistsBankAccountById(int, CancellationToken) : Task<bool>
      }
    }

    package "ACL" {
      class StaffContextFacade <<facade>> {
        +SumFixedCostsAccruedByPeriod(Period, CancellationToken) : Task<decimal>
        +FetchFixedCostsPaidByWeek(CashFlowWeek, CancellationToken) : Task<IDictionary<string, decimal>>
        +FetchFixedCostsScheduledByWeek(CashFlowWeek, CancellationToken) : Task<IDictionary<string, decimal>>
      }
    }
  }

  package "Infrastructure.Persistence.EFC.Repositories" {
    class EmployeeRepository <<repository>> {
      +FindByDniAsync(Dni, CancellationToken) : Task<Employee?>
      +FindActiveAsync(CancellationToken) : Task<IEnumerable<Employee>>
    }

    class FixedCostRepository <<repository>> {
      +FindByCodeAsync(CostCode, CancellationToken) : Task<FixedCost?>
      +FindActiveAsync(CancellationToken) : Task<IEnumerable<FixedCost>>
      +FindByEmployeeIdAsync(int, CancellationToken) : Task<IEnumerable<FixedCost>>
      +FindPaymentsByPeriodAsync(Period, CancellationToken) : Task<IEnumerable<FixedCostPayment>>
    }
  }

  package "Infrastructure.Persistence.EFC.Configuration.Extensions" {
    class StaffModelBuilderExtensions <<db-configuration>> {
      +{static} ApplyStaffConfiguration(ModelBuilder) : void
      --
      +employees: unique index (dni)
      +fixed_costs: unique index (code)
      +fixed_cost_payments: index (year, month)
    }
  }
}

package "External Contexts (ACL)" {
  interface ITreasuryContextFacade <<facade>>
}

package "Shared" {
  abstract class "Result<TValue, TError>" as ResultT <<result>>
  abstract class AggregateRoot <<aggregate-root>>
  interface IAuditableEntity <<auditable>>
  interface IDomainEvent <<event>>
  interface IBaseRepository<TEntity> <<repository>>
  interface IUnitOfWork <<unit-of-work>>
  class BaseRepository<TEntity> <<repository>>
  class Money <<value-object>>
  class Period <<value-object>>
  class CashFlowWeek <<value-object>>
}

' Relationships - Interfaces
EmployeesController --> IEmployeeCommandService : uses
EmployeesController --> IEmployeeQueryService : uses
EmployeesController --> EmployeeResourceFromEntityAssembler : uses
EmployeesController --> HireEmployeeCommandFromResourceAssembler : uses
FixedCostsController --> IFixedCostCommandService : uses
FixedCostsController --> IFixedCostQueryService : uses
FixedCostsController --> FixedCostResourceFromEntityAssembler : uses
FixedCostsController --> CreateFixedCostCommandFromResourceAssembler : uses
FixedCostPaymentsController --> IFixedCostCommandService : uses
FixedCostPaymentsController --> IFixedCostQueryService : uses
FixedCostPaymentsController --> RegisterFixedCostPaymentCommandFromResourceAssembler : uses
FixedCostPaymentsController --> FixedCostPaymentResourceFromEntityAssembler : uses

EmployeeResourceFromEntityAssembler ..> Employee : reads
EmployeeResourceFromEntityAssembler --> EmployeeResource : produces
HireEmployeeCommandFromResourceAssembler ..> HireEmployeeResource : reads
HireEmployeeCommandFromResourceAssembler --> HireEmployeeCommand : produces
FixedCostResourceFromEntityAssembler ..> FixedCost : reads
FixedCostResourceFromEntityAssembler --> FixedCostResource : produces
CreateFixedCostCommandFromResourceAssembler ..> CreateFixedCostResource : reads
CreateFixedCostCommandFromResourceAssembler --> CreateFixedCostCommand : produces
FixedCostPaymentResourceFromEntityAssembler ..> FixedCostPayment : reads
FixedCostPaymentResourceFromEntityAssembler --> FixedCostPaymentResource : produces
RegisterFixedCostPaymentCommandFromResourceAssembler ..> RegisterFixedCostPaymentResource : reads
RegisterFixedCostPaymentCommandFromResourceAssembler --> RegisterFixedCostPaymentCommand : produces

' Relationships - Application
EmployeeCommandService ..|> IEmployeeCommandService : implements
EmployeeQueryService ..|> IEmployeeQueryService : implements
FixedCostCommandService ..|> IFixedCostCommandService : implements
FixedCostQueryService ..|> IFixedCostQueryService : implements
StaffContextFacade ..|> IStaffContextFacade : implements
StaffContextFacade --> IFixedCostRepository : uses

EmployeeCommandService --> IEmployeeRepository : uses
EmployeeCommandService --> IUnitOfWork : uses
EmployeeQueryService --> IEmployeeRepository : uses
FixedCostCommandService --> IFixedCostRepository : uses
FixedCostCommandService --> IEmployeeRepository : uses
FixedCostCommandService --> IUnitOfWork : uses
FixedCostCommandService --> ExternalTreasuryService : uses
FixedCostCommandService ..> ResultT : returns
FixedCostQueryService --> IFixedCostRepository : uses
ExternalTreasuryService --> ITreasuryContextFacade : uses

' Relationships - Infrastructure
IEmployeeRepository --|> IBaseRepository : extends
IFixedCostRepository --|> IBaseRepository : extends
EmployeeRepository ..|> IEmployeeRepository : implements
EmployeeRepository --|> BaseRepository : extends
FixedCostRepository ..|> IFixedCostRepository : implements
FixedCostRepository --|> BaseRepository : extends

' Relationships - Domain
Employee ..|> IAuditableEntity : implements
FixedCost --|> AggregateRoot : extends
FixedCost ..|> IAuditableEntity : implements
Employee --> Dni : owns
Employee --> Money : owns
FixedCost --> CostCode : owns
FixedCost --> FixedCostType : has
FixedCost --> PaymentSchedule : owns
FixedCost "1" *-- "0..*" FixedCostPayment : contains
FixedCost "0..*" ..> "0..1" Employee : EmployeeId
FixedCostPayment --> Period : owns
FixedCostPayment --> Money : owns
FixedCost ..> FixedCostPaidEvent : raises
FixedCostPaidEvent ..|> IDomainEvent : implements

HireEmployeeCommand --> Dni : contains
CreateFixedCostCommand --> CostCode : contains
CreateFixedCostCommand --> FixedCostType : contains
RegisterFixedCostPaymentCommand --> Period : contains

note right of FixedCost
  Ejemplos del Excel:
  BR0100_01 Sueldo Miguel Lopez (Salary)
  BR0100_04 Sueldo Harumi Higa (Salary)
  BR0800 SCTR, BR09000 Oficina,
  BR3000_ITF ITF, BR010000 Comisiones
  Invariantes:
  - Type = Salary -> EmployeeId obligatorio
  - Pagos solo si IsActive
  - PendingIn(p) = MonthlyAmount - PaidIn(p)
  Los gastos de proyecto NO van aquí
  (en Excel se mezclaban en "Sueldo Miguel
  Lopez": 17,087.50 en setiembre) -> Expenses.
end note

note right of PaymentSchedule
  Usado por el flujo proyectado:
  en qué semana(s) del mes se espera
  pagar (ej. sueldo en Semana 05,
  limpieza en Semanas 01 y 03).
end note
@enduml
