@startuml
' Brasper Platform - Expenses Bounded Context (Proveedores y Gastos)

skinparam classAttributeIconSize 0
set separator none

package "Expenses" {

  package "Interfaces.REST" {
    class SuppliersController {
      +CreateSupplier(CreateSupplierResource, CancellationToken) : Task<ActionResult>
      +UpdateSupplier(int, UpdateSupplierResource, CancellationToken) : Task<ActionResult>
      +GetAllSuppliers(CancellationToken) : Task<ActionResult>
      +GetSupplierById(int, CancellationToken) : Task<ActionResult>
    }

    class ExpensesController {
      +RegisterExpense(RegisterExpenseResource, CancellationToken) : Task<ActionResult>
      +CorrectExpense(int, CorrectExpenseResource, CancellationToken) : Task<ActionResult>
      +AnnulExpense(int, CancellationToken) : Task<ActionResult>
      +GetAllExpenses(int?, int?, int?, string?, CancellationToken) : Task<ActionResult>
      +GetExpenseById(int, CancellationToken) : Task<ActionResult>
    }

    package "Resources" {
      class SupplierResource <<resource>> {
        +int Id
        +string BusinessName
        +string? Ruc
        +string Type
        +string? Phone
      }

      class CreateSupplierResource <<resource>> {
        +string BusinessName
        +string? Ruc
        +string Type
        +string? Phone
      }

      class UpdateSupplierResource <<resource>> {
        +string BusinessName
        +string? Phone
      }

      class ExpenseResource <<resource>> {
        +int Id
        +DateOnly SpentOn
        +int? ProjectId
        +int? SupplierId
        +string Category
        +string Description
        +string VoucherType
        +string? VoucherNumber
        +decimal TaxableBase
        +decimal Igv
        +decimal Total
        +string PaymentMethod
        +int? BankAccountId
        +int? PartnerId
        +string PaymentStatus
        +bool IsAnnulled
      }

      class RegisterExpenseResource <<resource>> {
        +DateOnly SpentOn
        +int? ProjectId
        +int? SupplierId
        +string Category
        +string Description
        +string VoucherType
        +string? VoucherNumber
        +decimal Amount
        +bool AmountIncludesIgv
        +string Currency
        +string PaymentMethod
        +int? BankAccountId
        +int? PartnerId
        +bool IsPaid
      }

      class CorrectExpenseResource <<resource>> {
        +int? ProjectId
        +string Category
        +string Description
      }
    }

    package "Transform" {
      class SupplierResourceFromEntityAssembler <<assembler>> {
        +ToResourceFromEntity(Supplier) : SupplierResource
      }

      class CreateSupplierCommandFromResourceAssembler <<assembler>> {
        +ToCommandFromResource(CreateSupplierResource) : CreateSupplierCommand
      }

      class ExpenseResourceFromEntityAssembler <<assembler>> {
        +ToResourceFromEntity(Expense) : ExpenseResource
      }

      class RegisterExpenseCommandFromResourceAssembler <<assembler>> {
        +ToCommandFromResource(RegisterExpenseResource) : RegisterExpenseCommand
      }

      class CorrectExpenseCommandFromResourceAssembler <<assembler>> {
        +ToCommandFromResource(int, CorrectExpenseResource) : CorrectExpenseCommand
      }
    }
  }

  package "Interfaces.ACL" {
    interface IExpensesContextFacade <<facade>> {
      +SumDirectCostByProject(int, CancellationToken) : Task<decimal>
      +FetchDirectCostByCategory(int, CancellationToken) : Task<IDictionary<string, decimal>>
      +SumInputIgvByPeriod(Period, CancellationToken) : Task<decimal>
      +SumPaidByWeek(CashFlowWeek, CancellationToken) : Task<decimal>
    }
  }

  package "Domain.Model" {
    package "ValueObjects" {
      enum SupplierType <<value-object>> {
        Company
        NaturalPerson
      }

      enum VoucherType <<value-object>> {
        Invoice
        SalesReceipt
        FeeReceipt
        NoVoucher
      }

      enum PaymentMethod <<value-object>> {
        BankAccount
        PettyCash
        PartnerContribution
      }

      class Voucher <<value-object>> {
        +VoucherType Type
        +string? Number
        +AllowsTaxCredit() : bool
      }
    }

    package "Commands" {
      class CreateSupplierCommand <<command>> {
        +string BusinessName
        +Ruc? Ruc
        +SupplierType Type
        +string? Phone
      }

      class UpdateSupplierCommand <<command>> {
        +int SupplierId
        +string BusinessName
        +string? Phone
      }

      class RegisterExpenseCommand <<command>> {
        +DateOnly SpentOn
        +int? ProjectId
        +int? SupplierId
        +CostCategory Category
        +string Description
        +Voucher Voucher
        +Money Amount
        +bool AmountIncludesIgv
        +PaymentMethod Method
        +int? BankAccountId
        +int? PartnerId
        +bool IsPaid
      }

      class CorrectExpenseCommand <<command>> {
        +int ExpenseId
        +int? ProjectId
        +CostCategory Category
        +string Description
      }

      class AnnulExpenseCommand <<command>> {
        +int ExpenseId
      }
    }

    package "Queries" {
      class GetAllSuppliersQuery <<query>>

      class GetSupplierByIdQuery <<query>> {
        +int Id
      }

      class GetAllExpensesQuery <<query>> {
        +int? ProjectId
        +Period? Period
        +CostCategory? Category
      }

      class GetExpenseByIdQuery <<query>> {
        +int Id
      }
    }

    package "Events" {
      class ExpenseRegisteredEvent <<event>> {
        +int ExpenseId
        +int? ProjectId
        +int? SupplierId
        +DateOnly SpentOn
        +CostCategory Category
        +TaxBreakdown Amounts
        +bool AllowsTaxCredit
        +PaymentMethod Method
        +int? BankAccountId
        +int? PartnerId
        +bool IsPaid
      }

      class ExpenseAnnulledEvent <<event>> {
        +int ExpenseId
        +DateOnly AnnulledOn
      }
    }

    package "Aggregates" {
      class Supplier <<aggregate>> {
        +int Id
        +string BusinessName
        +Ruc? Ruc
        +SupplierType Type
        +string? Phone
        +Supplier(CreateSupplierCommand)
        +Update(UpdateSupplierCommand) : void
      }

      class Expense <<aggregate>> {
        +int Id
        +DateOnly SpentOn
        +int? ProjectId
        +int? SupplierId
        +CostCategory Category
        +string Description
        +Voucher Voucher
        +TaxBreakdown Amounts
        +PaymentMethod Method
        +int? BankAccountId
        +int? PartnerId
        +PaymentStatus PaymentStatus
        +bool IsAnnulled
        +Expense(RegisterExpenseCommand, TaxRates)
        +Correct(CorrectExpenseCommand) : void
        +Annul() : void
        +MarkAsPaid() : void
        +IsDirectCost() : bool
        +GeneratesTaxCredit() : bool
      }
    }
  }

  package "Domain.Repositories" {
    interface ISupplierRepository <<repository>> {
      +FindByRucAsync(Ruc, CancellationToken) : Task<Supplier?>
      +ExistsByRucAsync(Ruc, CancellationToken) : Task<bool>
    }

    interface IExpenseRepository <<repository>> {
      +FindByProjectIdAsync(int, CancellationToken) : Task<IEnumerable<Expense>>
      +FindByPeriodAsync(Period, CancellationToken) : Task<IEnumerable<Expense>>
      +FindByCategoryAsync(CostCategory, CancellationToken) : Task<IEnumerable<Expense>>
    }
  }

  package "Application" {
    package "Errors" {
      enum CreateSupplierError <<error>> {
        InvalidRuc
        DuplicateRuc
        RucRequiredForCompany
        UnexpectedError
      }

      enum UpdateSupplierError <<error>> {
        SupplierNotFound
        UnexpectedError
      }

      enum RegisterExpenseError <<error>> {
        ProjectNotFound
        ProjectAlreadyClosed
        SupplierNotFound
        InvalidAmount
        BankAccountRequired
        BankAccountNotFound
        PartnerRequired
        PartnerNotFound
        UnexpectedError
      }

      enum UpdateExpenseError <<error>> {
        ExpenseNotFound
        ExpenseAnnulled
        ProjectNotFound
        UnexpectedError
      }
    }

    package "Services" {
      interface ISupplierCommandService <<application-service>> {
        +Handle(CreateSupplierCommand, CancellationToken) : Task<Result<Supplier, CreateSupplierError>>
        +Handle(UpdateSupplierCommand, CancellationToken) : Task<Result<Supplier, UpdateSupplierError>>
      }

      interface ISupplierQueryService <<application-service>> {
        +Handle(GetAllSuppliersQuery, CancellationToken) : Task<IEnumerable<Supplier>>
        +Handle(GetSupplierByIdQuery, CancellationToken) : Task<Supplier?>
      }

      interface IExpenseCommandService <<application-service>> {
        +Handle(RegisterExpenseCommand, CancellationToken) : Task<Result<Expense, RegisterExpenseError>>
        +Handle(CorrectExpenseCommand, CancellationToken) : Task<Result<Expense, UpdateExpenseError>>
        +Handle(AnnulExpenseCommand, CancellationToken) : Task<Result<Expense, UpdateExpenseError>>
      }

      interface IExpenseQueryService <<application-service>> {
        +Handle(GetAllExpensesQuery, CancellationToken) : Task<IEnumerable<Expense>>
        +Handle(GetExpenseByIdQuery, CancellationToken) : Task<Expense?>
      }
    }

    package "Internal.CommandServices" {
      class SupplierCommandService <<service>> {
        +Handle(CreateSupplierCommand, CancellationToken) : Task<Result<Supplier, CreateSupplierError>>
        +Handle(UpdateSupplierCommand, CancellationToken) : Task<Result<Supplier, UpdateSupplierError>>
      }

      class ExpenseCommandService <<service>> {
        +Handle(RegisterExpenseCommand, CancellationToken) : Task<Result<Expense, RegisterExpenseError>>
        +Handle(CorrectExpenseCommand, CancellationToken) : Task<Result<Expense, UpdateExpenseError>>
        +Handle(AnnulExpenseCommand, CancellationToken) : Task<Result<Expense, UpdateExpenseError>>
      }
    }

    package "Internal.QueryServices" {
      class SupplierQueryService <<service>> {
        +Handle(GetAllSuppliersQuery, CancellationToken) : Task<IEnumerable<Supplier>>
        +Handle(GetSupplierByIdQuery, CancellationToken) : Task<Supplier?>
      }

      class ExpenseQueryService <<service>> {
        +Handle(GetAllExpensesQuery, CancellationToken) : Task<IEnumerable<Expense>>
        +Handle(GetExpenseByIdQuery, CancellationToken) : Task<Expense?>
      }
    }

    package "Internal.EventHandlers" {
      class PayablePaidEventHandler <<event-handler>> {
        +Handle(PayablePaidEvent, CancellationToken) : Task
      }
    }

    package "Internal.OutboundServices.ACL" {
      class ExternalProjectService <<outbound-service>> {
        +ExistsProjectById(int, CancellationToken) : Task<bool>
        +FetchProjectStatus(int, CancellationToken) : Task<string?>
      }

      class ExternalTreasuryService <<outbound-service>> {
        +ExistsBankAccountById(int, CancellationToken) : Task<bool>
        +ExistsPartnerById(int, CancellationToken) : Task<bool>
      }

      class ExternalAccountingService <<outbound-service>> {
        +FetchTaxRatesAt(DateOnly, CancellationToken) : Task<TaxRates>
      }
    }

    package "ACL" {
      class ExpensesContextFacade <<facade>> {
        +SumDirectCostByProject(int, CancellationToken) : Task<decimal>
        +FetchDirectCostByCategory(int, CancellationToken) : Task<IDictionary<string, decimal>>
        +SumInputIgvByPeriod(Period, CancellationToken) : Task<decimal>
        +SumPaidByWeek(CashFlowWeek, CancellationToken) : Task<decimal>
      }
    }
  }

  package "Infrastructure.Persistence.EFC.Repositories" {
    class SupplierRepository <<repository>> {
      +FindByRucAsync(Ruc, CancellationToken) : Task<Supplier?>
      +ExistsByRucAsync(Ruc, CancellationToken) : Task<bool>
    }

    class ExpenseRepository <<repository>> {
      +FindByProjectIdAsync(int, CancellationToken) : Task<IEnumerable<Expense>>
      +FindByPeriodAsync(Period, CancellationToken) : Task<IEnumerable<Expense>>
      +FindByCategoryAsync(CostCategory, CancellationToken) : Task<IEnumerable<Expense>>
    }
  }

  package "Infrastructure.Persistence.EFC.Configuration.Extensions" {
    class ExpensesModelBuilderExtensions <<db-configuration>> {
      +{static} ApplyExpensesConfiguration(ModelBuilder) : void
      --
      +suppliers: unique index (ruc) where ruc is not null
      +expenses: index (project_id), index (spent_on)
    }
  }
}

package "External Contexts (ACL)" {
  interface IProjectsContextFacade <<facade>>
  interface ITreasuryContextFacade <<facade>>
  interface IAccountingContextFacade <<facade>>
  class PayablePaidEvent <<event>>
}

package "Shared" {
  abstract class "Result<TValue, TError>" as ResultT <<result>>
  abstract class AggregateRoot <<aggregate-root>>
  interface IAuditableEntity <<auditable>>
  interface IDomainEvent <<event>>
  interface IDomainEventHandler<TEvent> <<event-handler>>
  interface IBaseRepository<TEntity> <<repository>>
  interface IUnitOfWork <<unit-of-work>>
  class BaseRepository<TEntity> <<repository>>
  class Money <<value-object>>
  class Period <<value-object>>
  class Ruc <<value-object>>
  class TaxBreakdown <<value-object>>
  class TaxRates <<value-object>>
  enum CostCategory <<value-object>>
  enum PaymentStatus <<value-object>>
}

' Relationships - Interfaces
SuppliersController --> ISupplierCommandService : uses
SuppliersController --> ISupplierQueryService : uses
SuppliersController --> SupplierResourceFromEntityAssembler : uses
SuppliersController --> CreateSupplierCommandFromResourceAssembler : uses
ExpensesController --> IExpenseCommandService : uses
ExpensesController --> IExpenseQueryService : uses
ExpensesController --> ExpenseResourceFromEntityAssembler : uses
ExpensesController --> RegisterExpenseCommandFromResourceAssembler : uses
ExpensesController --> CorrectExpenseCommandFromResourceAssembler : uses

SupplierResourceFromEntityAssembler ..> Supplier : reads
SupplierResourceFromEntityAssembler --> SupplierResource : produces
CreateSupplierCommandFromResourceAssembler ..> CreateSupplierResource : reads
CreateSupplierCommandFromResourceAssembler --> CreateSupplierCommand : produces
ExpenseResourceFromEntityAssembler ..> Expense : reads
ExpenseResourceFromEntityAssembler --> ExpenseResource : produces
RegisterExpenseCommandFromResourceAssembler ..> RegisterExpenseResource : reads
RegisterExpenseCommandFromResourceAssembler --> RegisterExpenseCommand : produces
CorrectExpenseCommandFromResourceAssembler ..> CorrectExpenseResource : reads
CorrectExpenseCommandFromResourceAssembler --> CorrectExpenseCommand : produces

' Relationships - Application
SupplierCommandService ..|> ISupplierCommandService : implements
SupplierQueryService ..|> ISupplierQueryService : implements
ExpenseCommandService ..|> IExpenseCommandService : implements
ExpenseQueryService ..|> IExpenseQueryService : implements
ExpensesContextFacade ..|> IExpensesContextFacade : implements
ExpensesContextFacade --> IExpenseRepository : uses

SupplierCommandService --> ISupplierRepository : uses
SupplierCommandService --> IUnitOfWork : uses
SupplierQueryService --> ISupplierRepository : uses
ExpenseCommandService --> IExpenseRepository : uses
ExpenseCommandService --> ISupplierRepository : uses
ExpenseCommandService --> IUnitOfWork : uses
ExpenseCommandService --> ExternalProjectService : uses
ExpenseCommandService --> ExternalTreasuryService : uses
ExpenseCommandService --> ExternalAccountingService : uses
ExpenseCommandService ..> ResultT : returns
ExpenseQueryService --> IExpenseRepository : uses
PayablePaidEventHandler ..|> IDomainEventHandler : implements
PayablePaidEventHandler ..> PayablePaidEvent : handles
PayablePaidEventHandler --> IExpenseRepository : marks paid

ExternalProjectService --> IProjectsContextFacade : uses
ExternalTreasuryService --> ITreasuryContextFacade : uses
ExternalAccountingService --> IAccountingContextFacade : uses

' Relationships - Infrastructure
ISupplierRepository --|> IBaseRepository : extends
IExpenseRepository --|> IBaseRepository : extends
SupplierRepository ..|> ISupplierRepository : implements
SupplierRepository --|> BaseRepository : extends
ExpenseRepository ..|> IExpenseRepository : implements
ExpenseRepository --|> BaseRepository : extends

' Relationships - Domain
Supplier ..|> IAuditableEntity : implements
Expense --|> AggregateRoot : extends
Expense ..|> IAuditableEntity : implements
Supplier --> SupplierType : has
Supplier --> Ruc : owns
Expense --> Voucher : owns
Voucher --> VoucherType : has
Expense --> TaxBreakdown : owns
Expense --> CostCategory : has
Expense --> PaymentMethod : has
Expense --> PaymentStatus : has
Expense ..> TaxRates : uses
Expense "0..*" ..> "0..1" Supplier : SupplierId
Expense ..> ExpenseRegisteredEvent : raises
Expense ..> ExpenseAnnulledEvent : raises
ExpenseRegisteredEvent ..|> IDomainEvent : implements
ExpenseAnnulledEvent ..|> IDomainEvent : implements

RegisterExpenseCommand --> Voucher : contains
RegisterExpenseCommand --> PaymentMethod : contains
CreateSupplierCommand --> SupplierType : contains

note right of Expense
  Invariantes:
  - Method = BankAccount -> BankAccountId obligatorio
  - Method = PartnerContribution -> PartnerId obligatorio
    (en Excel: "Aportes Ingeniero")
  - Method = PettyCash -> cuenta tipo PettyCash
  - Siempre con PaymentMethod (en Excel había
    25,423.73 de 854BR sin forma de pago)
  - Amounts: si Voucher.AllowsTaxCredit()
      FromTotal/FromTaxableBase con IGV 18%
    si no -> TaxBreakdown.WithoutIgv
  - ProjectId null = gasto general (no costo directo)
  - No se elimina: se anula (Annul) para auditoría
  IsPaid = false -> Treasury crea un Payable
  (handler de ExpenseRegisteredEvent).
end note

note right of Voucher
  AllowsTaxCredit() = Type == Invoice
  (solo factura genera crédito fiscal IGV)
end note
@enduml
